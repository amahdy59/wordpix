# ---------------------------------------------------------------------------
# Public values. Anything prefixed VITE_ is inlined into the browser bundle by
# Vite, so ONLY put values here that are safe to publish.
# ---------------------------------------------------------------------------

# Public base URL of the asset bucket, e.g. https://assets.example.com
# (an R2 custom domain, or a Worker route). Leave blank locally: the app then
# has no CDN and falls back to speech synthesis, which is the correct
# behaviour for a checkout with no bucket.
VITE_ASSET_BASE_URL=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: the voice a learner picks for their own ElevenLabs key.
VITE_ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2

# ---------------------------------------------------------------------------
# Secrets. NEVER prefix these with VITE_ — that would inline them into the
# client bundle and publish them to every visitor.
#
# Used only by build scripts (scripts/generate_audio.cjs, scripts/upload_assets.cjs)
# and by CI. In CI they come from repository secrets instead of this file.
# ---------------------------------------------------------------------------

# ElevenLabs, for one-off generation of the audio corpus.
ELEVENLABS_API_KEY=

# Cloudflare R2. Account ID is on the R2 overview page; the key pair comes from
# "Manage R2 API Tokens".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Figma, for exporting artwork.
FIGMA_TOKEN=
FIGMA_FILE_KEY=gRlyhrMavAHXUAT5brWFWu
