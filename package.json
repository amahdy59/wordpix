{
  "name": "wordpix",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "scripts": {
    "assets:cors": "node scripts/setup_r2_cors.cjs",
    "assets:cors:check": "node scripts/setup_r2_cors.cjs --check",
    "assets:upload": "node scripts/upload_assets.cjs",
    "audio:curriculum:plan": "node scripts/generate_curriculum_words_audio.cjs --dry-run",
    "audio:curriculum:generate": "node scripts/generate_curriculum_words_audio.cjs",
    "audio:hadith:plan": "node scripts/generate_hadith_audio.cjs --dry-run",
    "audio:hadith:generate": "node scripts/generate_hadith_audio.cjs",
    "audio:hadith:verify": "node scripts/generate_hadith_audio.cjs --verify",
    "audio:pronunciation:plan": "node scripts/generate_pronunciation_audio.cjs --dry-run",
    "audio:pronunciation:generate": "node scripts/generate_pronunciation_audio.cjs",
    "audio:pronunciation:verify": "node scripts/generate_pronunciation_audio.cjs --verify",
    "assets:verify": "node scripts/verify_r2.cjs",
    "audio:corpus": "node scripts/build_audio_corpus.cjs",
    "audio:generate": "node scripts/generate_audio.cjs",
    "audio:check:bucket": "node scripts/check_bucket.cjs",
    "audio:check:lessons": "node scripts/check_lessons.cjs",
    "audio:check:words": "node scripts/check_words.cjs",
    "content:definitions:audit": "vite-node scripts/audit_vocabulary_definitions.ts",
    "content:definitions:review": "vite-node scripts/audit_vocabulary_definitions.ts --json",
    "content:definitions:apply-review": "python scripts/apply_vocabulary_definition_review.py docs/vocabulary-definition-review.csv",
    "content:curriculum:audit": "node --experimental-strip-types scripts/audit-curriculum-content.ts",
    "content:context:audit": "vitest run src/app/__tests__/contextual_quality.test.ts --reporter=verbose",
    "content:usage:manifests": "node scripts/build_usage_authoring_manifests.mjs",
    "content:usage:manifests:check": "node scripts/build_usage_authoring_manifests.mjs --check",
    "content:usage:relevance": "vite-node scripts/audit_usage_relevance.ts",
    "content:usage:diversity": "node scripts/audit_usage_sentence_diversity.mjs",
    "content:usage:workbook:check": "node output/usage-authoring/verify_all_lesson_packages.mjs && node output/usage-authoring/verify_approvals.mjs",
    "content:usage:export-approved": "node output/usage-authoring/export_approved_usage_phrases.mjs",
    "content:usage:images:batch1:check": "node scripts/verify_batch1_usage_images.mjs",
    "content:usage:images:batch1:manifest": "node scripts/build_usage_image_manifest_batch_02.mjs 1 20 docs/usage-image-manifest-batch-01.csv 91",
    "content:usage:images:batch2:manifest": "node scripts/build_usage_image_manifest_batch_02.mjs",
    "content:usage:images:batch2:check": "node scripts/verify_usage_images_batch_02.mjs",
    "content:pronunciation:r2-audit": "node scripts/audit_pronunciation_r2.cjs",
    "content:conversation:images": "node scripts/import_conversation_figma_images.cjs",
    "audio:pronunciation:manifest": "node scripts/reconcile_pronunciation_audio.cjs --inspect-metadata=10000",
    "audio:plan": "node scripts/generate_audio.cjs --dry-run",
    "audio:subscription": "node scripts/check_elevenlabs_subscription.mjs",
    "audio:reconcile": "node scripts/generate_audio.cjs --reconcile",
    "build": "node scripts/build_group_thumbnails.mjs && node scripts/shard_specialist_catalogs.mjs && node scripts/shard_learning_content.mjs && vite build",
    "check:bundle": "node scripts/check_bundle_budget.mjs",
    "check:content-shards": "node scripts/shard_learning_content.mjs --check",
    "check:secrets": "node scripts/check_secret_hygiene.mjs",
    "check:security": "pnpm run check:secrets && pnpm audit --audit-level high",
    "check:deploy": "node scripts/check_live_deployment.mjs",
    "check:doctor": "node scripts/deployment-doctor.mjs",
    "deploy:watch": "node scripts/watch_deployment.mjs",
    "dev": "node scripts/build_group_thumbnails.mjs && node scripts/shard_learning_content.mjs && vite",
    "doctor": "node scripts/deployment-doctor.mjs",
    "doctor:fix": "node scripts/deployment-doctor.mjs --auto-fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "ship": "git push origin main; node scripts/watch_deployment.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "analyze": "node scripts/analyze_bundle.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify_prepush.mjs",
    "verify:deploy": "node scripts/verify_deployment.mjs",
    "verify:staging:auth": "node scripts/verify_staging_auth.mjs",
    "verify:prepush": "node scripts/verify_prepush.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.4",
    "framer-motion": "^13.0.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "tw-animate-css": "^1.3.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@axe-core/react": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
