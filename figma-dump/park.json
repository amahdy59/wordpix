    "mini-dialogue": {
      "nodeId": "542:2266",
      "lines": [
        {
          "text": "🗣️ Mini Dialogue",
          "depth": 1,
          "name": "🗣️ Mini Dialogue"
        },
        {
          "text": "Scene: Two friends meeting at the park",
          "depth": 1,
          "name": "Scene: Two friends meeting at the park"
        },
        {
          "text": "Yusuf:",
          "depth": 2,
          "name": "Yusuf:"
        },
        {
          "text": "Hey! I didn't expect to see you here. Are you jogging?",
          "depth": 2,
          "name": "Hey! I didn't expect to see you here. Are you jogging?"
        },
        {
          "text": "Hana:",
          "depth": 2,
          "name": "Hana:"
        },
        {
          "text": "Yes, I try to run around the track twice every morning.",
          "depth": 2,
          "name": "Yes, I try to run around the track twice every morning."
        },
        {
          "text": "Yusuf:",
          "depth": 2,
          "name": "Yusuf:"
        },
        {
          "text": "I brought my nephew to the playground. He's on the swings.",
          "depth": 2,
          "name": "I brought my nephew to the playground. He's on the swings."
        },
        {
          "text": "Hana:",
          "depth": 2,
          "name": "Hana:"
        },
        {
          "text": "This park is great for kids — so much space.",
          "depth": 2,
          "name": "This park is great for kids — so much space."
        },
        {
          "text": "Yusuf:",
          "depth": 2,
          "name": "Yusuf:"
        },
        {
          "text": "After the playground, we'll feed the ducks by the pond.",
          "depth": 2,
          "name": "After the playground, we'll feed the ducks by the pond."
        },
        {
          "text": "Hana:",
          "depth": 2,
          "name": "Hana:"
        },
        {
          "text": "I love that spot. The bridge over the pond is really pretty.",
          "depth": 2,
          "name": "I love that spot. The bridge over the pond is really pretty."
        },
        {
          "text": "Yusuf:",
          "depth": 2,
          "name": "Yusuf:"
        },
        {
          "text": "Have you been to the new café near the car park?",
          "depth": 2,
          "name": "Have you been to the new café near the car park?"
        },
        {
          "text": "Hana:",
          "depth": 2,
          "name": "Hana:"
        },
        {
          "text": "Not yet! Is it good?",
          "depth": 2,
          "name": "Not yet! Is it good?"
        },
        {
          "text": "Yusuf:",
          "depth": 2,
          "name": "Yusuf:"
        },
        {
          "text": "Yes, fresh juice and sandwiches. Let's go after your run.",
          "depth": 2,
          "name": "Yes, fresh juice and sandwiches. Let's go after your run."
        },
        {
          "text": "Hana:",
          "depth": 2,
          "name": "Hana:"
        },
        {
          "text": "Sounds like a plan. One more lap and I'll meet you there!",
          "depth": 2,
          "name": "Sounds like a plan. One more lap and I'll meet you there!"
        }
      ]
    },
    "common-mistakes": {
      "nodeId": "542:2301",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"I went to the park for walk.\"",
          "depth": 2,
          "name": "❌ \"I went to the park for walk.\""
        },
        {
          "text": "✅ \"I went to the park for a walk.\"",
          "depth": 2,
          "name": "✅ \"I went to the park for a walk.\""
        },
        {
          "text": "Don't forget the article 'a' — 'for a walk', 'for a jog', 'for a run'.",
          "depth": 2,
          "name": "Don't forget the article 'a' — 'for a walk', 'for a jog', 'for a run'."
        },
        {
          "text": "❌ \"The children play in the swings.\"",
          "depth": 2,
          "name": "❌ \"The children play in the swings.\""
        },
        {
          "text": "✅ \"The children play on the swings.\"",
          "depth": 2,
          "name": "✅ \"The children play on the swings.\""
        },
        {
          "text": "Use 'on' for swings, slides, climbing frames — you're physically on them.",
          "depth": 2,
          "name": "Use 'on' for swings, slides, climbing frames — you're physically on them."
        },
        {
          "text": "❌ \"We made a picnic in the park.\"",
          "depth": 2,
          "name": "❌ \"We made a picnic in the park.\""
        },
        {
          "text": "✅ \"We had a picnic in the park.\"",
          "depth": 2,
          "name": "✅ \"We had a picnic in the park.\""
        },
        {
          "text": "The correct collocation is 'have a picnic', not 'make a picnic'.",
          "depth": 2,
          "name": "The correct collocation is 'have a picnic', not 'make a picnic'."
        },
        {
          "text": "❌ \"There are many persons in the park.\"",
          "depth": 2,
          "name": "❌ \"There are many persons in the park.\""
        },
        {
          "text": "✅ \"There are many people in the park.\"",
          "depth": 2,
          "name": "✅ \"There are many people in the park.\""
        },
        {
          "text": "'People' is the standard plural. 'Persons' is very formal/legal.",
          "depth": 2,
          "name": "'People' is the standard plural. 'Persons' is very formal/legal."
        },
        {
          "text": "❌ \"I like to go to park on Sundays.\"",
          "depth": 2,
          "name": "❌ \"I like to go to park on Sundays.\""
        },
        {
          "text": "✅ \"I like to go to the park on Sundays.\"",
          "depth": 2,
          "name": "✅ \"I like to go to the park on Sundays.\""
        },
        {
          "text": "Use 'the' before 'park' when referring to a specific one.",
          "depth": 2,
          "name": "Use 'the' before 'park' when referring to a specific one."
        }
      ]
    },
