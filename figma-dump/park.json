        {
          "text": "💬 Idioms, Phrasal Verbs & Key Phrases",
          "depth": 1,
          "name": "💬 Idioms, Phrasal Verbs & Key Phrases"
        },
        {
          "text": "a walk in the park",
          "depth": 2,
          "name": "a walk in the park"
        },
        {
          "text": "something very easy",
          "depth": 2,
          "name": "something very easy"
        },
        {
          "text": "\"The exam was a walk in the park — I finished in 20 minutes.\"",
          "depth": 2,
          "name": "\"The exam was a walk in the park — I finished in 20 minutes.\""
        },
        {
          "text": "go for a stroll",
          "depth": 2,
          "name": "go for a stroll"
        },
        {
          "text": "take a slow, relaxed walk",
