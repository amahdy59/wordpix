    "cultural-notes": {
      "nodeId": "542:2403",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "Parks in English-Speaking Countries",
          "depth": 2,
          "name": "Parks in English-Speaking Countries"
        },
        {
          "text": "Public parks are free and central to community life. 'Central Park' (NYC), 'Hyde Park' (London), and 'Stanley Park' (Vancouver) are famous examples.",
          "depth": 2,
          "name": "Public parks are free and central to community life. 'Central Park' (NYC), 'Hyde Park' (London), and 'Stanley Park' (Vancouver) are famous examples."
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "British: 'rubbish bin' / American: 'trash can'. British: 'car park' / American: 'parking lot'. British: 'public toilets' / American: 'restrooms'.",
          "depth": 2,
          "name": "British: 'rubbish bin' / American: 'trash can'. British: 'car park' / American: 'parking lot'. British: 'public toilets' / American: 'restrooms'."
        },
        {
          "text": "Dog Parks",
          "depth": 2,
          "name": "Dog Parks"
        },
        {
          "text": "Many parks have 'off-lead zones' (UK) or 'off-leash areas' (US) where dogs can run free. Signs say 'Dogs must be kept on a lead/leash' elsewhere.",
          "depth": 2,
          "name": "Many parks have 'off-lead zones' (UK) or 'off-leash areas' (US) where dogs can run free. Signs say 'Dogs must be kept on a lead/leash' elsewhere."
        },
        {
          "text": "Park Etiquette",
          "depth": 2,
          "name": "Park Etiquette"
        },
        {
          "text": "Common rules: 'keep off the grass', 'no littering', 'pick up after your dog'. Understanding these signs is useful when visiting English-speaking countries.",
          "depth": 2,
          "name": "Common rules: 'keep off the grass', 'no littering', 'pick up after your dog'. Understanding these signs is useful when visiting English-speaking countries."
        },
        {
          "text": "Playground vs Play Area",
          "depth": 2,
          "name": "Playground vs Play Area"
        },
        {
          "text": "'Playground' is most common for the area with swings and slides. 'Play area' appears on signs. 'Playpark' is used in Scotland.",
          "depth": 2,
          "name": "'Playground' is most common for the area with swings and slides. 'Play area' appears on signs. 'Playpark' is used in Scotland."
        }
      ]
    },
