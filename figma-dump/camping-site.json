    "mini-dialogue": {
      "nodeId": "547:2846",
      "lines": [
        {
          "text": "🗣️ Mini Dialogue",
          "depth": 1,
          "name": "🗣️ Mini Dialogue"
        },
        {
          "text": "Scene: A family arriving at the campsite reception",
          "depth": 1,
          "name": "Scene: A family arriving at the campsite reception"
        },
        {
          "text": "Warden:",
          "depth": 2,
          "name": "Warden:"
        },
        {
          "text": "Good afternoon! Do you have a booking?",
          "depth": 2,
          "name": "Good afternoon! Do you have a booking?"
        },
        {
          "text": "Father:",
          "depth": 2,
          "name": "Father:"
        },
        {
          "text": "Yes, under the name Hussain. Two nights, Friday and Saturday.",
          "depth": 2,
          "name": "Yes, under the name Hussain. Two nights, Friday and Saturday."
        },
        {
          "text": "Warden:",
          "depth": 2,
          "name": "Warden:"
        },
        {
          "text": "Perfect. You're on pitch 14 — it's a lovely spot near the stream.",
          "depth": 2,
          "name": "Perfect. You're on pitch 14 — it's a lovely spot near the stream."
        },
        {
          "text": "Father:",
          "depth": 2,
          "name": "Father:"
        },
        {
          "text": "Are campfires allowed?",
          "depth": 2,
          "name": "Are campfires allowed?"
        },
        {
          "text": "Warden:",
          "depth": 2,
          "name": "Warden:"
        },
        {
          "text": "Yes, but only in the fire pits provided. No fires directly on the grass, please.",
          "depth": 2,
          "name": "Yes, but only in the fire pits provided. No fires directly on the grass, please."
        },
        {
          "text": "Father:",
          "depth": 2,
          "name": "Father:"
        },
        {
          "text": "Where are the shower facilities?",
          "depth": 2,
          "name": "Where are the shower facilities?"
        },
        {
          "text": "Warden:",
          "depth": 2,
          "name": "Warden:"
        },
        {
          "text": "The shower block is behind the reception building. It's open twenty-four hours.",
          "depth": 2,
          "name": "The shower block is behind the reception building. It's open twenty-four hours."
        },
        {
          "text": "Son:",
          "depth": 2,
          "name": "Son:"
        },
        {
          "text": "Is there Wi-Fi?",
          "depth": 2,
          "name": "Is there Wi-Fi?"
        },
        {
          "text": "Warden:",
          "depth": 2,
          "name": "Warden:"
        },
        {
          "text": "I'm afraid not. That's the joy of camping — unplugging from technology!",
          "depth": 2,
          "name": "I'm afraid not. That's the joy of camping — unplugging from technology!"
        },
        {
          "text": "Father:",
          "depth": 2,
          "name": "Father:"
        },
        {
          "text": "What time is check-out on Sunday?",
          "depth": 2,
          "name": "What time is check-out on Sunday?"
        },
        {
          "text": "Warden:",
          "depth": 2,
          "name": "Warden:"
        },
        {
          "text": "Midday, please. And remember — leave no trace. Take all your rubbish with you.",
          "depth": 2,
          "name": "Midday, please. And remember — leave no trace. Take all your rubbish with you."
        }
      ]
    },
    "common-mistakes": {
      "nodeId": "547:2884",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"We made a camping last weekend.\"",
          "depth": 2,
          "name": "❌ \"We made a camping last weekend.\""
        },
        {
          "text": "✅ \"We went camping last weekend.\"",
          "depth": 2,
          "name": "✅ \"We went camping last weekend.\""
        },
        {
          "text": "In English, you 'go camping' — not 'make a camping' or 'do a camping'. Similarly: go hiking, go fishing, go swimming.",
          "depth": 2,
          "name": "In English, you 'go camping' — not 'make a camping' or 'do a camping'. Similarly: go hiking, go fishing, go swimming."
        },
        {
          "text": "❌ \"We slept in a camp.\"",
          "depth": 2,
          "name": "❌ \"We slept in a camp.\""
        },
        {
          "text": "✅ \"We slept at a campsite.\" / \"We slept in a tent.\"",
          "depth": 2,
          "name": "✅ \"We slept at a campsite.\" / \"We slept in a tent.\""
        },
        {
          "text": "A 'camp' usually refers to a military camp or a children's summer camp. The place where you pitch a tent is called a 'campsite'.",
          "depth": 2,
          "name": "A 'camp' usually refers to a military camp or a children's summer camp. The place where you pitch a tent is called a 'campsite'."
        },
        {
          "text": "❌ \"The fire was very hot. I could not come near.\"",
          "depth": 2,
          "name": "❌ \"The fire was very hot. I could not come near.\""
        },
        {
          "text": "✅ \"The fire was very hot. I could not go/get near it.\"",
          "depth": 2,
          "name": "✅ \"The fire was very hot. I could not go/get near it.\""
        },
        {
          "text": "Use 'go near' or 'get near' for approaching something. 'Come' implies movement toward the speaker, not toward an object.",
          "depth": 2,
          "name": "Use 'go near' or 'get near' for approaching something. 'Come' implies movement toward the speaker, not toward an object."
        },
        {
          "text": "❌ \"We saw much stars in the sky.\"",
          "depth": 2,
          "name": "❌ \"We saw much stars in the sky.\""
        },
        {
          "text": "✅ \"We saw many stars in the sky.\"",
          "depth": 2,
          "name": "✅ \"We saw many stars in the sky.\""
        },
        {
          "text": "Use 'many' with countable nouns (stars, trees, people). Use 'much' with uncountable nouns (water, time, money).",
          "depth": 2,
          "name": "Use 'many' with countable nouns (stars, trees, people). Use 'much' with uncountable nouns (water, time, money)."
        },
        {
          "text": "❌ \"I am afraid of the dark.\" (wrong for B1 — it's actually correct!)",
          "depth": 2,
          "name": "❌ \"I am afraid of the dark.\" (wrong for B1 — it's actually correct!)"
        },
        {
          "text": "✅ \"I am afraid of the dark.\" — This IS correct!",
          "depth": 2,
          "name": "✅ \"I am afraid of the dark.\" — This IS correct!"
        },
        {
          "text": "A reminder that 'afraid of + noun/gerund' is the right pattern. Common similar phrases: afraid of heights, afraid of spiders, afraid of flying.",
          "depth": 2,
          "name": "A reminder that 'afraid of + noun/gerund' is the right pattern. Common similar phrases: afraid of heights, afraid of spiders, afraid of flying."
        }
      ]
    },
