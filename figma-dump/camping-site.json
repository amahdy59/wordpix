    "cultural-notes": {
      "nodeId": "547:2986",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "Camping in the UK",
          "depth": 2,
          "name": "Camping in the UK"
        },
        {
          "text": "The UK has thousands of campsites, from basic fields to luxury 'glamping' sites. The Lake District, Snowdonia, and the Scottish Highlands are popular camping destinations. Wild camping (camping outside official sites) is generally not allowed in England and Wales but is legal in Scotland.",
          "depth": 2,
          "name": "The UK has thousands of campsites, from basic fields to luxury 'glamping' sites. The Lake District, Snowdonia, and the Scottish Highlands are popular camping destinations. Wild camping (camping outside official sites) is generally not allowed in England and Wales but is legal in Scotland."
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Terms",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Terms"
        },
        {
          "text": "British: 'campsite' / American: 'campground'. British: 'torch' / American: 'flashlight'. British: 'cool box' / American: 'cooler'. British: 'caravan' / American: 'RV' (recreational vehicle) or 'trailer'.",
          "depth": 2,
          "name": "British: 'campsite' / American: 'campground'. British: 'torch' / American: 'flashlight'. British: 'cool box' / American: 'cooler'. British: 'caravan' / American: 'RV' (recreational vehicle) or 'trailer'."
        },
        {
          "text": "Glamping",
          "depth": 2,
          "name": "Glamping"
        },
        {
          "text": "'Glamping' = glamorous + camping. It means camping with luxury comforts: proper beds, electricity, heating, and sometimes even hot tubs. Yurts, bell tents, treehouses, and shepherd's huts are popular glamping options.",
          "depth": 2,
          "name": "'Glamping' = glamorous + camping. It means camping with luxury comforts: proper beds, electricity, heating, and sometimes even hot tubs. Yurts, bell tents, treehouses, and shepherd's huts are popular glamping options."
        },
        {
          "text": "The Countryside Code",
          "depth": 2,
          "name": "The Countryside Code"
        },
        {
          "text": "In England and Wales, the Countryside Code asks visitors to: respect other people, protect the natural environment, and enjoy the outdoors responsibly. Key rules: close gates behind you, keep dogs under control, and take litter home.",
          "depth": 2,
          "name": "In England and Wales, the Countryside Code asks visitors to: respect other people, protect the natural environment, and enjoy the outdoors responsibly. Key rules: close gates behind you, keep dogs under control, and take litter home."
        },
        {
          "text": "Duke of Edinburgh Award",
          "depth": 2,
          "name": "Duke of Edinburgh Award"
        },
        {
          "text": "The 'DofE' is a popular programme for UK young people aged 14–24. It includes an expedition section where participants camp outdoors and navigate routes using maps and compasses. It's excellent vocabulary for camping and outdoor activities.",
          "depth": 2,
          "name": "The 'DofE' is a popular programme for UK young people aged 14–24. It includes an expedition section where participants camp outdoors and navigate routes using maps and compasses. It's excellent vocabulary for camping and outdoor activities."
        }
      ]
    },
