    "cultural-notes": {
      "nodeId": "542:1291",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "British: \"wardrobe\" / American: \"closet\". British: \"duvet\" / American: \"comforter\". British: \"chest of drawers\" / American: \"dresser\" (both are used in both dialects, but preference differs).",
          "depth": 2,
          "name": "British: \"wardrobe\" / American: \"closet\". British: \"duvet\" / American: \"comforter\". British: \"chest of drawers\" / American: \"dresser\" (both are used in both dialects, but preference differs)."
        },
        {
          "text": "Bedroom vs Bed Room",
          "depth": 2,
          "name": "Bedroom vs Bed Room"
        },
        {
          "text": "'Bedroom' is always written as one word. Writing 'bed room' (two words) is incorrect in modern English.",
          "depth": 2,
          "name": "'Bedroom' is always written as one word. Writing 'bed room' (two words) is incorrect in modern English."
        },
        {
          "text": "Make the Bed",
          "depth": 2,
          "name": "Make the Bed"
        },
        {
          "text": "In English-speaking cultures, 'making the bed' (straightening sheets, fluffing pillows) is considered a daily habit. It appears often in household vocabulary and instructions.",
          "depth": 2,
          "name": "In English-speaking cultures, 'making the bed' (straightening sheets, fluffing pillows) is considered a daily habit. It appears often in household vocabulary and instructions."
        },
        {
          "text": "Guest Room vs Spare Room",
          "depth": 2,
          "name": "Guest Room vs Spare Room"
        },
        {
          "text": "'Spare room' (British) and 'guest room' (American) both refer to an extra bedroom. 'Master bedroom' is the largest bedroom, though some now prefer 'primary bedroom'.",
          "depth": 2,
          "name": "'Spare room' (British) and 'guest room' (American) both refer to an extra bedroom. 'Master bedroom' is the largest bedroom, though some now prefer 'primary bedroom'."
        },
        {
          "text": "Counting Bedrooms",
          "depth": 2,
          "name": "Counting Bedrooms"
        },
        {
          "text": "Property listings use bedroom count as a key feature: 'a three-bedroom house', 'a studio flat' (no separate bedroom). This is important for housing vocabulary.",
          "depth": 2,
          "name": "Property listings use bedroom count as a key feature: 'a three-bedroom house', 'a studio flat' (no separate bedroom). This is important for housing vocabulary."
        }
      ]
    },
