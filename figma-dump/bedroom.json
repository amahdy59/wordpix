    "common-mistakes": {
      "nodeId": "542:1189",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"I made my homework on the desk.\"",
          "depth": 2,
          "name": "❌ \"I made my homework on the desk.\""
        },
        {
          "text": "✅ \"I did my homework at the desk.\"",
          "depth": 2,
          "name": "✅ \"I did my homework at the desk.\""
        },
        {
          "text": "Use 'do homework', not 'make homework'. Use 'at the desk', not 'on'.",
          "depth": 2,
          "name": "Use 'do homework', not 'make homework'. Use 'at the desk', not 'on'."
        },
        {
          "text": "❌ \"I opened the light.\"",
          "depth": 2,
          "name": "❌ \"I opened the light.\""
        },
        {
          "text": "✅ \"I turned on the light.\"",
          "depth": 2,
          "name": "✅ \"I turned on the light.\""
        },
        {
          "text": "In English we 'turn on/off' lights, not 'open/close' them.",
          "depth": 2,
          "name": "In English we 'turn on/off' lights, not 'open/close' them."
        },
        {
          "text": "❌ \"I have a furniture in my room.\"",
          "depth": 2,
          "name": "❌ \"I have a furniture in my room.\""
        },
        {
          "text": "✅ \"I have a piece of furniture in my room.\" / \"I have furniture in my room.\"",
          "depth": 2,
          "name": "✅ \"I have a piece of furniture in my room.\" / \"I have furniture in my room.\""
        },
        {
          "text": "'Furniture' is uncountable. Use 'a piece of furniture' for one item.",
          "depth": 2,
          "name": "'Furniture' is uncountable. Use 'a piece of furniture' for one item."
        },
        {
          "text": "❌ \"I slept at 10 o'clock.\"",
          "depth": 2,
          "name": "❌ \"I slept at 10 o'clock.\""
        },
        {
          "text": "✅ \"I went to bed / fell asleep at 10 o'clock.\"",
          "depth": 2,
          "name": "✅ \"I went to bed / fell asleep at 10 o'clock.\""
        },
        {
          "text": "'Slept' describes the state, not the moment of starting. Use 'went to bed' or 'fell asleep'.",
          "depth": 2,
          "name": "'Slept' describes the state, not the moment of starting. Use 'went to bed' or 'fell asleep'."
        },
        {
          "text": "❌ \"I put my clothes in the hanger.\"",
          "depth": 2,
          "name": "❌ \"I put my clothes in the hanger.\""
        },
        {
          "text": "✅ \"I put my clothes on the hanger.\"",
          "depth": 2,
          "name": "✅ \"I put my clothes on the hanger.\""
        },
        {
          "text": "Clothes go 'on' a hanger, not 'in' one.",
          "depth": 2,
          "name": "Clothes go 'on' a hanger, not 'in' one."
        }
      ]
    },
