          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "✗  \"I wash my teeth every morning.\"",
          "depth": 2,
          "name": "✗ \"I wash my teeth every morning.\""
        },
        {
          "text": "✓  \"I brush my teeth every morning.\"",
          "depth": 2,
          "name": "✓ \"I brush my teeth every morning.\""
        },
        {
          "text": "In English, we 'brush' teeth, not 'wash' them.",
          "depth": 2,
          "name": "In English, we 'brush' teeth, not 'wash' them."
        },
        {
          "text": "✗  \"I want to take a bath shower.\"",
          "depth": 2,
          "name": "✗ \"I want to take a bath shower.\""
        },
        {
          "text": "✓  \"I want to take a shower.\" / \"I want to take a bath.\"",
          "depth": 2,
          "name": "✓ \"I want to take a shower.\" / \"I want to take a bath.\""
        },
        {
          "text": "A shower and a bath are different. Choose one.",
          "depth": 2,
          "name": "A shower and a bath are different. Choose one."
        },
        {
          "text": "✗  \"Give me the paste of teeth.\"",
          "depth": 2,
          "name": "✗ \"Give me the paste of teeth.\""
        },
        {
          "text": "✓  \"Give me the toothpaste.\"",
          "depth": 2,
          "name": "✓ \"Give me the toothpaste.\""
        },
        {
          "text": "'Toothpaste' is one compound word, not translated word by word.",
          "depth": 2,
          "name": "'Toothpaste' is one compound word, not translated word by word."
        },
        {
          "text": "✗  \"She dried her hair with the hairbrush.\"",
          "depth": 2,
          "name": "✗ \"She dried her hair with the hairbrush.\""
        },
        {
          "text": "✓  \"She dried her hair with the hair dryer.\"",
          "depth": 2,
          "name": "✓ \"She dried her hair with the hair dryer.\""
        },
        {
          "text": "A hairbrush is for brushing. A hair dryer is for drying.",
          "depth": 2,
          "name": "A hairbrush is for brushing. A hair dryer is for drying."
        },
        {
          "text": "✗  \"I looked at me in the glass.\"",
          "depth": 2,
          "name": "✗ \"I looked at me in the glass.\""
        },
        {
          "text": "✓  \"I looked at myself in the mirror.\"",
          "depth": 2,
          "name": "✓ \"I looked at myself in the mirror.\""
        },
        {
          "text": "Use 'mirror' (not 'glass') and 'myself' (reflexive pronoun).",
          "depth": 2,
          "name": "Use 'mirror' (not 'glass') and 'myself' (reflexive pronoun)."
        },
        {
          "text": "✗  \"Please open the faucet.\"",
          "depth": 2,
          "name": "✗ \"Please open the faucet.\""
        },
        {
          "text": "✓  \"Please turn on the faucet.\"",
          "depth": 2,
          "name": "✓ \"Please turn on the faucet.\""
        },
        {
          "text": "We 'turn on' or 'turn off' a faucet, not 'open' or 'close' it.",
          "depth": 2,
          "name": "We 'turn on' or 'turn off' a faucet, not 'open' or 'close' it."
        }
      ]
