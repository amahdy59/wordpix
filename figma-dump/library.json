    "cultural-notes": {
      "nodeId": "542:3507",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "Public Libraries Are Free",
          "depth": 2,
          "name": "Public Libraries Are Free"
        },
        {
          "text": "In the UK, US, and most English-speaking countries, public libraries are free to join. Anyone with proof of address can get a library card. This is a fundamental public service.",
          "depth": 2,
          "name": "In the UK, US, and most English-speaking countries, public libraries are free to join. Anyone with proof of address can get a library card. This is a fundamental public service."
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "Both use 'library'. British: 'catalogue' / American: 'catalog'. British: 'ground floor' / American: 'first floor'. Both say 'librarian', 'borrow', 'return'.",
          "depth": 2,
          "name": "Both use 'library'. British: 'catalogue' / American: 'catalog'. British: 'ground floor' / American: 'first floor'. Both say 'librarian', 'borrow', 'return'."
        },
        {
          "text": "Library Etiquette",
          "depth": 2,
          "name": "Library Etiquette"
        },
        {
          "text": "Common rules: speak quietly, turn off your phone, don't eat or drink near books, return books on time. Breaking these rules may result in a warning or a ban.",
          "depth": 2,
          "name": "Common rules: speak quietly, turn off your phone, don't eat or drink near books, return books on time. Breaking these rules may result in a warning or a ban."
        },
        {
          "text": "E-books and Digital Libraries",
          "depth": 2,
          "name": "E-books and Digital Libraries"
        },
        {
          "text": "Modern libraries lend e-books, audiobooks, and DVDs. Apps like Libby and OverDrive let you borrow digital books for free with a library card. This vocabulary is increasingly common.",
          "depth": 2,
          "name": "Modern libraries lend e-books, audiobooks, and DVDs. Apps like Libby and OverDrive let you borrow digital books for free with a library card. This vocabulary is increasingly common."
        },
        {
          "text": "ISBN and Dewey Decimal System",
          "depth": 2,
          "name": "ISBN and Dewey Decimal System"
        },
        {
          "text": "Books are organised using the Dewey Decimal Classification (000–999). Understanding labels like '823 — English Fiction' helps you navigate library shelves independently.",
          "depth": 2,
          "name": "Books are organised using the Dewey Decimal Classification (000–999). Understanding labels like '823 — English Fiction' helps you navigate library shelves independently."
        }
      ]
    },
