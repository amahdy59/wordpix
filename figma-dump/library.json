    "exercises": {
      "nodeId": "542:3489",
      "lines": [
        {
          "text": "🧩 Fill-in-the-Blank Exercises",
          "depth": 1,
          "name": "🧩 Fill-in-the-Blank Exercises"
        },
        {
          "text": "Complete each sentence with a word from this page.",
          "depth": 1,
          "name": "Complete each sentence with a word from this page."
        },
        {
          "text": "1.  You need a library __________ to borrow books.",
          "depth": 1,
          "name": "1. You need a library __________ to borrow books."
        },
        {
          "text": "2.  The __________ helped me find a novel by my favourite author.",
          "depth": 1,
          "name": "2. The __________ helped me find a novel by my favourite author."
        },
        {
          "text": "3.  Please return the books before the __________ date.",
          "depth": 1,
          "name": "3. Please return the books before the __________ date."
        },
        {
          "text": "4.  She searched the __________ computer for a book on astronomy.",
          "depth": 1,
          "name": "4. She searched the __________ computer for a book on astronomy."
        },
        {
          "text": "5.  The __________ section has encyclopedias and journals you cannot take home.",
          "depth": 1,
          "name": "5. The __________ section has encyclopedias and journals you cannot take home."
        },
        {
          "text": "6.  He paid a small __________ because his book was overdue.",
          "depth": 1,
          "name": "6. He paid a small __________ because his book was overdue."
        },
        {
          "text": "7.  The reading room is a quiet __________ — no talking allowed.",
          "depth": 1,
          "name": "7. The reading room is a quiet __________ — no talking allowed."
        },
        {
          "text": "8.  I like to __________ through the new arrivals shelf on Saturdays.",
          "depth": 1,
          "name": "8. I like to __________ through the new arrivals shelf on Saturdays."
        },
        {
          "text": "9.  She __________ out three mystery novels last week.",
          "depth": 1,
          "name": "9. She __________ out three mystery novels last week."
        },
        {
          "text": "10. The library organises a __________ club for adults every month.",
          "depth": 1,
          "name": "10. The library organises a __________ club for adults every month."
        },
        {
          "text": "Answer Key",
          "depth": 2,
          "name": "Answer Key"
        },
        {
          "text": "1. card  2. librarian  3. due  4. catalogue  5. reference  6. fine  7. zone  8. browse  9. checked / took  10. book",
          "depth": 2,
          "name": "1. card 2. librarian 3. due 4. catalogue 5. reference 6. fine 7. zone 8. browse 9. checked / took 10. book"
