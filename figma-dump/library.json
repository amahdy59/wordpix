    "mini-dialogue": {
      "nodeId": "542:3370",
      "lines": [
        {
          "text": "🗣️ Mini Dialogue",
          "depth": 1,
          "name": "🗣️ Mini Dialogue"
        },
        {
          "text": "Scene: A visitor asks the librarian for help",
          "depth": 1,
          "name": "Scene: A visitor asks the librarian for help"
        },
        {
          "text": "Visitor:",
          "depth": 2,
          "name": "Visitor:"
        },
        {
          "text": "Excuse me, I'm looking for a book on world history. Can you help?",
          "depth": 2,
          "name": "Excuse me, I'm looking for a book on world history. Can you help?"
        },
        {
          "text": "Librarian:",
          "depth": 2,
          "name": "Librarian:"
        },
        {
          "text": "Of course. Do you have a specific title in mind?",
          "depth": 2,
          "name": "Of course. Do you have a specific title in mind?"
        },
        {
          "text": "Visitor:",
          "depth": 2,
          "name": "Visitor:"
        },
        {
          "text": "Not really. Something for a B1 English learner.",
          "depth": 2,
          "name": "Not really. Something for a B1 English learner."
        },
        {
          "text": "Librarian:",
          "depth": 2,
          "name": "Librarian:"
        },
        {
          "text": "Let me check the catalogue. We have a few simplified readers in the non-fiction section.",
          "depth": 2,
          "name": "Let me check the catalogue. We have a few simplified readers in the non-fiction section."
        },
        {
          "text": "Visitor:",
          "depth": 2,
          "name": "Visitor:"
        },
        {
          "text": "Great. How many books can I borrow at once?",
          "depth": 2,
          "name": "Great. How many books can I borrow at once?"
        },
        {
          "text": "Librarian:",
          "depth": 2,
          "name": "Librarian:"
        },
        {
          "text": "Up to five, for three weeks. Do you have a library card?",
          "depth": 2,
          "name": "Up to five, for three weeks. Do you have a library card?"
        },
        {
          "text": "Visitor:",
          "depth": 2,
          "name": "Visitor:"
        },
        {
          "text": "Not yet. How do I get one?",
          "depth": 2,
          "name": "Not yet. How do I get one?"
        },
        {
          "text": "Librarian:",
          "depth": 2,
          "name": "Librarian:"
        },
        {
          "text": "Fill in this form with your name and address. I'll print your card right away.",
          "depth": 2,
          "name": "Fill in this form with your name and address. I'll print your card right away."
        },
        {
          "text": "Visitor:",
          "depth": 2,
          "name": "Visitor:"
        },
        {
          "text": "Thank you. Is there a quiet place where I can sit and read?",
          "depth": 2,
          "name": "Thank you. Is there a quiet place where I can sit and read?"
        },
        {
          "text": "Librarian:",
          "depth": 2,
          "name": "Librarian:"
        },
        {
          "text": "Yes, the reading room is upstairs. Just remember — it's a quiet zone, so no phone calls.",
          "depth": 2,
          "name": "Yes, the reading room is upstairs. Just remember — it's a quiet zone, so no phone calls."
        }
      ]
    },
    "common-mistakes": {
      "nodeId": "542:3405",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"I borrowed him a book.\"",
          "depth": 2,
          "name": "❌ \"I borrowed him a book.\""
        },
        {
          "text": "✅ \"I lent him a book.\" / \"He borrowed a book from me.\"",
          "depth": 2,
          "name": "✅ \"I lent him a book.\" / \"He borrowed a book from me.\""
        },
        {
          "text": "You lend TO someone and borrow FROM someone. Never 'borrow someone something'.",
          "depth": 2,
          "name": "You lend TO someone and borrow FROM someone. Never 'borrow someone something'."
        },
        {
          "text": "❌ \"I went to the library for lend a book.\"",
          "depth": 2,
          "name": "❌ \"I went to the library for lend a book.\""
        },
        {
          "text": "✅ \"I went to the library to borrow a book.\"",
          "depth": 2,
          "name": "✅ \"I went to the library to borrow a book.\""
        },
        {
          "text": "Use 'to + verb' for purpose. And the library visitor borrows — the library lends.",
          "depth": 2,
          "name": "Use 'to + verb' for purpose. And the library visitor borrows — the library lends."
        },
        {
          "text": "❌ \"The book is very interested.\"",
          "depth": 2,
          "name": "❌ \"The book is very interested.\""
        },
        {
          "text": "✅ \"The book is very interesting.\"",
          "depth": 2,
          "name": "✅ \"The book is very interesting.\""
        },
        {
          "text": "-ING describes the thing that causes the feeling. -ED describes the person who feels it. 'The book is interesting; I am interested.'",
          "depth": 2,
          "name": "-ING describes the thing that causes the feeling. -ED describes the person who feels it. 'The book is interesting; I am interested.'"
        },
        {
          "text": "❌ \"Can you recommend me a good book?\"",
          "depth": 2,
          "name": "❌ \"Can you recommend me a good book?\""
        },
        {
          "text": "✅ \"Can you recommend a good book (to me)?\"",
          "depth": 2,
          "name": "✅ \"Can you recommend a good book (to me)?\""
        },
        {
          "text": "'Recommend' doesn't take an indirect object directly. Say 'recommend something' or 'recommend something to someone'.",
          "depth": 2,
          "name": "'Recommend' doesn't take an indirect object directly. Say 'recommend something' or 'recommend something to someone'."
        },
        {
          "text": "❌ \"I have been to the library since two hours.\"",
          "depth": 2,
          "name": "❌ \"I have been to the library since two hours.\""
        },
        {
          "text": "✅ \"I have been at the library for two hours.\"",
          "depth": 2,
          "name": "✅ \"I have been at the library for two hours.\""
        },
        {
          "text": "Use 'for' with a duration (for two hours) and 'since' with a point in time (since 3 PM). Also: 'at the library', not 'to'.",
          "depth": 2,
          "name": "Use 'for' with a duration (for two hours) and 'since' with a point in time (since 3 PM). Also: 'at the library', not 'to'."
        }
      ]
    },
