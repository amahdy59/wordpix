    "cultural-notes": {
      "nodeId": "542:2679",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "Playground Safety Standards",
          "depth": 2,
          "name": "Playground Safety Standards"
        },
        {
          "text": "In English-speaking countries, playgrounds must meet strict safety standards. Rubber tiles, soft mulch, or sand cushion falls. Signs list age ranges for each piece of equipment.",
          "depth": 2,
          "name": "In English-speaking countries, playgrounds must meet strict safety standards. Rubber tiles, soft mulch, or sand cushion falls. Signs list age ranges for each piece of equipment."
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "British: 'roundabout' / American: 'merry-go-round'. British: 'see-saw' / American: 'teeter-totter'. British: 'climbing frame' / American: 'jungle gym'.",
          "depth": 2,
          "name": "British: 'roundabout' / American: 'merry-go-round'. British: 'see-saw' / American: 'teeter-totter'. British: 'climbing frame' / American: 'jungle gym'."
        },
        {
          "text": "Taking Turns — A Cultural Value",
          "depth": 2,
          "name": "Taking Turns — A Cultural Value"
        },
        {
          "text": "'Take turns' is one of the first social rules children learn. Adults use it too: 'Let's take turns speaking.' Teaching turn-taking is central to British and American education.",
          "depth": 2,
          "name": "'Take turns' is one of the first social rules children learn. Adults use it too: 'Let's take turns speaking.' Teaching turn-taking is central to British and American education."
        },
        {
          "text": "Recess vs Break Time",
          "depth": 2,
          "name": "Recess vs Break Time"
        },
        {
          "text": "In American schools, children play outside during 'recess'. In British schools, it's called 'break' or 'playtime'. Both refer to the free time between lessons.",
          "depth": 2,
          "name": "In American schools, children play outside during 'recess'. In British schools, it's called 'break' or 'playtime'. Both refer to the free time between lessons."
        },
        {
          "text": "Indoor vs Outdoor Playgrounds",
          "depth": 2,
          "name": "Indoor vs Outdoor Playgrounds"
        },
        {
          "text": "Many shopping centres and restaurants have 'indoor play areas' or 'soft play centres'. These are common in the UK and are popular on rainy days.",
          "depth": 2,
          "name": "Many shopping centres and restaurants have 'indoor play areas' or 'soft play centres'. These are common in the UK and are popular on rainy days."
        }
      ]
    },
