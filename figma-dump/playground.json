    "mini-dialogue": {
      "nodeId": "542:2542",
      "lines": [
        {
          "text": "🗣️ Mini Dialogue",
          "depth": 1,
          "name": "🗣️ Mini Dialogue"
        },
        {
          "text": "Scene: A parent and child at the playground",
          "depth": 1,
          "name": "Scene: A parent and child at the playground"
        },
        {
          "text": "Layla:",
          "depth": 2,
          "name": "Layla:"
        },
        {
          "text": "Can I go on the climbing wall first? Please!",
          "depth": 2,
          "name": "Can I go on the climbing wall first? Please!"
        },
        {
          "text": "Dad:",
          "depth": 2,
          "name": "Dad:"
        },
        {
          "text": "Sure, but be careful. Hold on to the coloured holds tightly.",
          "depth": 2,
          "name": "Sure, but be careful. Hold on to the coloured holds tightly."
        },
        {
          "text": "Layla:",
          "depth": 2,
          "name": "Layla:"
        },
        {
          "text": "I made it to the top! Can I try the monkey bars next?",
          "depth": 2,
          "name": "I made it to the top! Can I try the monkey bars next?"
        },
        {
          "text": "Dad:",
          "depth": 2,
          "name": "Dad:"
        },
        {
          "text": "Yes, but take turns — there's a queue.",
          "depth": 2,
          "name": "Yes, but take turns — there's a queue."
        },
        {
          "text": "Layla:",
          "depth": 2,
          "name": "Layla:"
        },
        {
          "text": "Okay. After that, can we go on the swings?",
          "depth": 2,
          "name": "Okay. After that, can we go on the swings?"
        },
        {
          "text": "Dad:",
          "depth": 2,
          "name": "Dad:"
        },
        {
          "text": "Of course. I'll push you. But first, drink some water at the fountain.",
          "depth": 2,
          "name": "Of course. I'll push you. But first, drink some water at the fountain."
        },
        {
          "text": "Layla:",
          "depth": 2,
          "name": "Layla:"
        },
        {
          "text": "Dad, look! The roundabout is free. Can I go?",
          "depth": 2,
          "name": "Dad, look! The roundabout is free. Can I go?"
        },
        {
          "text": "Dad:",
          "depth": 2,
          "name": "Dad:"
        },
        {
          "text": "Go ahead, but don't spin too fast — you'll get dizzy.",
          "depth": 2,
          "name": "Go ahead, but don't spin too fast — you'll get dizzy."
        },
        {
          "text": "Layla:",
          "depth": 2,
          "name": "Layla:"
        },
        {
          "text": "This is so much fun! I love the playground.",
          "depth": 2,
          "name": "This is so much fun! I love the playground."
        },
        {
          "text": "Dad:",
          "depth": 2,
          "name": "Dad:"
        },
        {
          "text": "Me too. But it's almost dinner time — five more minutes, okay?",
          "depth": 2,
          "name": "Me too. But it's almost dinner time — five more minutes, okay?"
        }
      ]
