    "common-mistakes": {
      "nodeId": "542:2577",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"The children play in the slide.\"",
          "depth": 2,
          "name": "❌ \"The children play in the slide.\""
        },
        {
          "text": "✅ \"The children play on the slide.\"",
          "depth": 2,
          "name": "✅ \"The children play on the slide.\""
        },
        {
          "text": "Use 'on' for equipment you physically sit or stand on: on the slide, on the swings, on the seesaw.",
          "depth": 2,
          "name": "Use 'on' for equipment you physically sit or stand on: on the slide, on the swings, on the seesaw."
        },
        {
          "text": "❌ \"She falled from the climbing frame.\"",
          "depth": 2,
          "name": "❌ \"She falled from the climbing frame.\""
        },
        {
          "text": "✅ \"She fell from the climbing frame.\"",
          "depth": 2,
          "name": "✅ \"She fell from the climbing frame.\""
        },
        {
          "text": "'Fall' is irregular: fall–fell–fallen. There is no 'falled'.",
          "depth": 2,
          "name": "'Fall' is irregular: fall–fell–fallen. There is no 'falled'."
        },
        {
          "text": "❌ \"Wait your turn — it's my round.\"",
          "depth": 2,
          "name": "❌ \"Wait your turn — it's my round.\""
        },
        {
          "text": "✅ \"Wait your turn — it's my turn.\"",
          "depth": 2,
          "name": "✅ \"Wait your turn — it's my turn.\""
        },
        {
          "text": "'Turn' is the correct word. 'Round' is used differently (a round of drinks, a round of golf).",
          "depth": 2,
          "name": "'Turn' is the correct word. 'Round' is used differently (a round of drinks, a round of golf)."
        },
        {
          "text": "❌ \"He climbed the ladder up.\"",
          "depth": 2,
          "name": "❌ \"He climbed the ladder up.\""
        },
        {
          "text": "✅ \"He climbed up the ladder.\"",
          "depth": 2,
          "name": "✅ \"He climbed up the ladder.\""
        },
        {
          "text": "The particle 'up' goes after the verb, not after the noun: 'climb up the ladder', 'go down the slide'.",
          "depth": 2,
          "name": "The particle 'up' goes after the verb, not after the noun: 'climb up the ladder', 'go down the slide'."
        },
        {
          "text": "❌ \"The playground has a very funny slide.\"",
          "depth": 2,
          "name": "❌ \"The playground has a very funny slide.\""
        },
        {
          "text": "✅ \"The playground has a really fun slide.\"",
          "depth": 2,
          "name": "✅ \"The playground has a really fun slide.\""
        },
        {
          "text": "'Fun' describes enjoyable activities. 'Funny' means something that makes you laugh.",
          "depth": 2,
          "name": "'Fun' describes enjoyable activities. 'Funny' means something that makes you laugh."
        }
      ]
    },
