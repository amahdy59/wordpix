    "common-mistakes": {
      "nodeId": "547:3160",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"We went to a park of attractions.\"",
          "depth": 2,
          "name": "❌ \"We went to a park of attractions.\""
        },
        {
          "text": "✅ \"We went to an amusement park.\" / \"...a theme park.\"",
          "depth": 2,
          "name": "✅ \"We went to an amusement park.\" / \"...a theme park.\""
        },
        {
          "text": "In English, use the compound noun 'amusement park' or 'theme park'. 'Park of attractions' is a translation from other languages.",
          "depth": 2,
          "name": "In English, use the compound noun 'amusement park' or 'theme park'. 'Park of attractions' is a translation from other languages."
        },
        {
          "text": "❌ \"The queue was very long. We waited on it for an hour.\"",
          "depth": 2,
          "name": "❌ \"The queue was very long. We waited on it for an hour.\""
        },
        {
          "text": "✅ \"We waited in the queue for an hour.\"",
          "depth": 2,
          "name": "✅ \"We waited in the queue for an hour.\""
        },
        {
          "text": "British English: 'wait in a queue' / 'stand in a queue'. American English: 'wait in line' / 'stand in line'. Not 'wait on'.",
          "depth": 2,
          "name": "British English: 'wait in a queue' / 'stand in a queue'. American English: 'wait in line' / 'stand in line'. Not 'wait on'."
        },
        {
          "text": "❌ \"I was very excited with the ride.\"",
          "depth": 2,
          "name": "❌ \"I was very excited with the ride.\""
        },
        {
          "text": "✅ \"I was very excited about/by the ride.\"",
          "depth": 2,
          "name": "✅ \"I was very excited about/by the ride.\""
        },
        {
          "text": "Use 'excited about' (anticipation) or 'excited by' (reaction). Not 'excited with'.",
          "depth": 2,
          "name": "Use 'excited about' (anticipation) or 'excited by' (reaction). Not 'excited with'."
        },
        {
          "text": "❌ \"The ride was very funny.\"",
          "depth": 2,
          "name": "❌ \"The ride was very funny.\""
        },
        {
          "text": "✅ \"The ride was a lot of fun.\" / \"The ride was thrilling.\"",
          "depth": 2,
          "name": "✅ \"The ride was a lot of fun.\" / \"The ride was thrilling.\""
        },
        {
          "text": "'Funny' means it makes you laugh (comedy). 'Fun' means you enjoyed it. Rides are 'fun', 'exciting', or 'thrilling' — not usually 'funny'.",
          "depth": 2,
          "name": "'Funny' means it makes you laugh (comedy). 'Fun' means you enjoyed it. Rides are 'fun', 'exciting', or 'thrilling' — not usually 'funny'."
        },
        {
          "text": "❌ \"We paid an entrance to the park.\"",
          "depth": 2,
          "name": "❌ \"We paid an entrance to the park.\""
        },
        {
          "text": "✅ \"We paid an entrance fee.\" / \"We paid the admission price.\"",
          "depth": 2,
          "name": "✅ \"We paid an entrance fee.\" / \"We paid the admission price.\""
        },
        {
          "text": "'Entrance' alone is a noun meaning the doorway. The money you pay is the 'entrance fee' or 'admission price'.",
          "depth": 2,
          "name": "'Entrance' alone is a noun meaning the doorway. The money you pay is the 'entrance fee' or 'admission price'."
        }
      ]
    },
