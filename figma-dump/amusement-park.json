    "cultural-notes": {
      "nodeId": "547:3262",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "Theme Parks vs Amusement Parks",
          "depth": 2,
          "name": "Theme Parks vs Amusement Parks"
        },
        {
          "text": "A 'theme park' has areas designed around specific themes (e.g. fantasy, adventure, movies). An 'amusement park' is more general — rides and games without a unifying theme. In practice, people often use the terms interchangeably.",
          "depth": 2,
          "name": "A 'theme park' has areas designed around specific themes (e.g. fantasy, adventure, movies). An 'amusement park' is more general — rides and games without a unifying theme. In practice, people often use the terms interchangeably."
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Terms",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Terms"
        },
        {
          "text": "British: 'candyfloss' / American: 'cotton candy'. British: 'dodgems' / American: 'bumper cars'. British: 'queue' / American: 'line'. British: 'funfair' / American: 'carnival' or 'fair'.",
          "depth": 2,
          "name": "British: 'candyfloss' / American: 'cotton candy'. British: 'dodgems' / American: 'bumper cars'. British: 'queue' / American: 'line'. British: 'funfair' / American: 'carnival' or 'fair'."
        },
        {
          "text": "Famous UK Theme Parks",
          "depth": 2,
          "name": "Famous UK Theme Parks"
        },
        {
          "text": "Alton Towers, Thorpe Park, and Legoland Windsor are among the UK's most popular theme parks. Blackpool Pleasure Beach is one of the oldest amusement parks in the world, opening in 1896.",
          "depth": 2,
          "name": "Alton Towers, Thorpe Park, and Legoland Windsor are among the UK's most popular theme parks. Blackpool Pleasure Beach is one of the oldest amusement parks in the world, opening in 1896."
        },
        {
          "text": "Funfairs & Travelling Fairs",
          "depth": 2,
          "name": "Funfairs & Travelling Fairs"
        },
        {
          "text": "A 'funfair' or 'travelling fair' is a temporary amusement park that moves from town to town. They often appear during bank holidays or local festivals, with rides, food stalls, and game booths.",
          "depth": 2,
          "name": "A 'funfair' or 'travelling fair' is a temporary amusement park that moves from town to town. They often appear during bank holidays or local festivals, with rides, food stalls, and game booths."
        },
        {
          "text": "Safety Vocabulary",
          "depth": 2,
          "name": "Safety Vocabulary"
        },
        {
          "text": "Key safety phrases: 'height restriction', 'must be accompanied by an adult', 'keep your hands inside the ride', 'fasten your seatbelt', 'this ride is not suitable for people with heart conditions'.",
          "depth": 2,
          "name": "Key safety phrases: 'height restriction', 'must be accompanied by an adult', 'keep your hands inside the ride', 'fasten your seatbelt', 'this ride is not suitable for people with heart conditions'."
        }
      ]
    },
