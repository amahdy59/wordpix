    "cultural-notes": {
      "nodeId": "544:1303",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "British: 'sports centre' / American: 'gym' or 'fitness center'. British: 'trainers' (shoes) / American: 'sneakers'. British: 'changing room' / American: 'locker room'. British: 'pitch' / American: 'field'.",
          "depth": 2,
          "name": "British: 'sports centre' / American: 'gym' or 'fitness center'. British: 'trainers' (shoes) / American: 'sneakers'. British: 'changing room' / American: 'locker room'. British: 'pitch' / American: 'field'."
        },
        {
          "text": "Gym Etiquette",
          "depth": 2,
          "name": "Gym Etiquette"
        },
        {
          "text": "Common rules: wipe equipment after use, don't hog machines, re-rack weights, use a towel, don't use your phone on equipment. Breaking these rules is considered very rude.",
          "depth": 2,
          "name": "Common rules: wipe equipment after use, don't hog machines, re-rack weights, use a towel, don't use your phone on equipment. Breaking these rules is considered very rude."
        },
        {
          "text": "'Do', 'Play', or 'Go'?",
          "depth": 2,
          "name": "'Do', 'Play', or 'Go'?"
        },
        {
          "text": "'Do' + individual activities: do yoga, do karate, do aerobics. 'Play' + ball/team sports: play football, play tennis. 'Go' + -ing activities: go swimming, go running, go cycling.",
          "depth": 2,
          "name": "'Do' + individual activities: do yoga, do karate, do aerobics. 'Play' + ball/team sports: play football, play tennis. 'Go' + -ing activities: go swimming, go running, go cycling."
        },
        {
          "text": "Personal Trainer (PT)",
          "depth": 2,
          "name": "Personal Trainer (PT)"
        },
        {
          "text": "A 'PT' or 'personal trainer' creates individual fitness plans. First sessions are often free. Common phrases: 'book a PT session', 'my PT says...', 'work with a trainer'.",
          "depth": 2,
          "name": "A 'PT' or 'personal trainer' creates individual fitness plans. First sessions are often free. Common phrases: 'book a PT session', 'my PT says...', 'work with a trainer'."
        },
        {
          "text": "January Rush",
          "depth": 2,
          "name": "January Rush"
        },
        {
          "text": "In English-speaking countries, gyms are busiest in January (New Year's resolutions). This is called the 'January rush'. By February, many people stop going — a widely known cultural joke.",
          "depth": 2,
          "name": "In English-speaking countries, gyms are busiest in January (New Year's resolutions). This is called the 'January rush'. By February, many people stop going — a widely known cultural joke."
        }
      ]
    },
