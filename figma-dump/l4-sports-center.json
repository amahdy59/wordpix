    "common-mistakes": {
      "nodeId": "544:1201",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"I play gym every day.\"",
          "depth": 2,
          "name": "❌ \"I play gym every day.\""
        },
        {
          "text": "✅ \"I go to the gym every day.\"",
          "depth": 2,
          "name": "✅ \"I go to the gym every day.\""
        },
        {
          "text": "You 'go to the gym', not 'play gym'. 'Play' is for sports and games: play football, play tennis.",
          "depth": 2,
          "name": "You 'go to the gym', not 'play gym'. 'Play' is for sports and games: play football, play tennis."
        },
        {
          "text": "❌ \"She does sport every morning.\"",
          "depth": 2,
          "name": "❌ \"She does sport every morning.\""
        },
        {
          "text": "✅ \"She does exercise / plays sport every morning.\"",
          "depth": 2,
          "name": "✅ \"She does exercise / plays sport every morning.\""
        },
        {
          "text": "British: 'do sport' or 'play sport'. American: 'play sports' (plural). 'Do exercise' works in both.",
          "depth": 2,
          "name": "British: 'do sport' or 'play sport'. American: 'play sports' (plural). 'Do exercise' works in both."
        },
        {
          "text": "❌ \"He trained hardly for the match.\"",
          "depth": 2,
          "name": "❌ \"He trained hardly for the match.\""
        },
        {
          "text": "✅ \"He trained hard for the match.\"",
          "depth": 2,
          "name": "✅ \"He trained hard for the match.\""
        },
        {
          "text": "'Hard' is both adjective and adverb. 'Hardly' means 'almost not' — completely different meaning!",
          "depth": 2,
          "name": "'Hard' is both adjective and adverb. 'Hardly' means 'almost not' — completely different meaning!"
        },
        {
          "text": "❌ \"I am interesting in joining the gym.\"",
          "depth": 2,
          "name": "❌ \"I am interesting in joining the gym.\""
        },
        {
          "text": "✅ \"I am interested in joining the gym.\"",
          "depth": 2,
          "name": "✅ \"I am interested in joining the gym.\""
        },
        {
          "text": "-ED for feelings: 'I am interested.' -ING for things that cause the feeling: 'The gym is interesting.'",
          "depth": 2,
          "name": "-ED for feelings: 'I am interested.' -ING for things that cause the feeling: 'The gym is interesting.'"
        },
        {
          "text": "❌ \"She swims since two years.\"",
          "depth": 2,
          "name": "❌ \"She swims since two years.\""
        },
        {
          "text": "✅ \"She has been swimming for two years.\"",
          "depth": 2,
          "name": "✅ \"She has been swimming for two years.\""
        },
        {
          "text": "Use 'for' + duration. Use present perfect continuous for ongoing activities.",
          "depth": 2,
          "name": "Use 'for' + duration. Use present perfect continuous for ongoing activities."
        }
      ]
    },
