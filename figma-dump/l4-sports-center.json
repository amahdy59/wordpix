          "text": "Staff:",
          "depth": 2,
          "name": "Staff:"
        },
        {
          "text": "Fifty pounds a month. Students get twenty percent off.",
          "depth": 2,
          "name": "Fifty pounds a month. Students get twenty percent off."
        },
        {
          "text": "New member:",
          "depth": 2,
          "name": "New member:"
        },
        {
          "text": "Is there a personal trainer available?",
          "depth": 2,
          "name": "Is there a personal trainer available?"
        },
        {
          "text": "Staff:",
          "depth": 2,
          "name": "Staff:"
        },
        {
          "text": "Yes, you can book a session at reception. The first one is free.",
