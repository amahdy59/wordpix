        {
          "text": "New member:",
          "depth": 2,
          "name": "New member:"
        },
        {
          "text": "Hi, I'd like to join the sports centre. What do you offer?",
          "depth": 2,
          "name": "Hi, I'd like to join the sports centre. What do you offer?"
        },
        {
          "text": "Staff:",
          "depth": 2,
          "name": "Staff:"
        },
        {
          "text": "We have a fully equipped gym, a swimming pool, and courts for tennis and basketball.",
          "depth": 2,
          "name": "We have a fully equipped gym, a swimming pool, and courts for tennis and basketball."
        },
        {
          "text": "New member:",
          "depth": 2,
          "name": "New member:"
        },
        {
          "text": "Do you have group classes?",
          "depth": 2,
          "name": "Do you have group classes?"
        },
        {
          "text": "Staff:",
          "depth": 2,
          "name": "Staff:"
        },
        {
          "text": "Yes — yoga, aerobics, spinning, and martial arts. Here's the timetable.",
          "depth": 2,
          "name": "Yes — yoga, aerobics, spinning, and martial arts. Here's the timetable."
        },
        {
          "text": "New member:",
          "depth": 2,
          "name": "New member:"
        },
        {
          "text": "Great. How much is the membership?",
          "depth": 2,
          "name": "Great. How much is the membership?"
        },
