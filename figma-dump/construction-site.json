    "mini-dialogue": {
      "nodeId": "547:2567",
      "lines": [
        {
          "text": "🗣️ Mini Dialogue",
          "depth": 1,
          "name": "🗣️ Mini Dialogue"
        },
        {
          "text": "Scene: A site manager talking to a visitor",
          "depth": 1,
          "name": "Scene: A site manager talking to a visitor"
        },
        {
          "text": "Manager:",
          "depth": 2,
          "name": "Manager:"
        },
        {
          "text": "Welcome to the site. Before we go in, you'll need a hard hat and a high-vis jacket.",
          "depth": 2,
          "name": "Welcome to the site. Before we go in, you'll need a hard hat and a high-vis jacket."
        },
        {
          "text": "Visitor:",
          "depth": 2,
          "name": "Visitor:"
        },
        {
          "text": "Thank you. How long has the project been going on?",
          "depth": 2,
          "name": "Thank you. How long has the project been going on?"
        },
        {
          "text": "Manager:",
          "depth": 2,
          "name": "Manager:"
        },
        {
          "text": "We started six months ago. The foundations took about eight weeks.",
          "depth": 2,
          "name": "We started six months ago. The foundations took about eight weeks."
        },
        {
          "text": "Visitor:",
          "depth": 2,
          "name": "Visitor:"
        },
        {
          "text": "What stage are you at now?",
          "depth": 2,
          "name": "What stage are you at now?"
        },
        {
          "text": "Manager:",
          "depth": 2,
          "name": "Manager:"
        },
        {
          "text": "We've finished the ground floor walls. The bricklayers are working on the first floor.",
          "depth": 2,
          "name": "We've finished the ground floor walls. The bricklayers are working on the first floor."
        },
        {
          "text": "Visitor:",
          "depth": 2,
          "name": "Visitor:"
        },
        {
          "text": "What's that large machine over there?",
          "depth": 2,
          "name": "What's that large machine over there?"
        },
        {
          "text": "Manager:",
          "depth": 2,
          "name": "Manager:"
        },
        {
          "text": "That's the excavator. We used it to dig the trenches for the drainage pipes.",
          "depth": 2,
          "name": "That's the excavator. We used it to dig the trenches for the drainage pipes."
        },
        {
          "text": "Visitor:",
          "depth": 2,
          "name": "Visitor:"
        },
        {
          "text": "And the crane?",
          "depth": 2,
          "name": "And the crane?"
        },
        {
          "text": "Manager:",
          "depth": 2,
          "name": "Manager:"
        },
        {
          "text": "The crane lifts heavy materials to the upper levels. It can carry up to five tonnes.",
          "depth": 2,
          "name": "The crane lifts heavy materials to the upper levels. It can carry up to five tonnes."
        },
        {
          "text": "Visitor:",
          "depth": 2,
          "name": "Visitor:"
        },
        {
          "text": "When will the school be ready?",
          "depth": 2,
          "name": "When will the school be ready?"
        },
        {
          "text": "Manager:",
          "depth": 2,
          "name": "Manager:"
        },
        {
          "text": "We're aiming for September. After the structure is complete, the electricians and plumbers will finish the interior.",
          "depth": 2,
          "name": "We're aiming for September. After the structure is complete, the electricians and plumbers will finish the interior."
        }
      ]
    },
    "common-mistakes": {
      "nodeId": "547:2605",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"The building is in construction.\"",
          "depth": 2,
          "name": "❌ \"The building is in construction.\""
        },
        {
          "text": "✅ \"The building is under construction.\"",
          "depth": 2,
          "name": "✅ \"The building is under construction.\""
        },
        {
          "text": "The correct expression is 'under construction', not 'in construction'. Similarly: 'under repair', 'under renovation'.",
          "depth": 2,
          "name": "The correct expression is 'under construction', not 'in construction'. Similarly: 'under repair', 'under renovation'."
        },
        {
          "text": "❌ \"He works like a bricklayer.\"",
          "depth": 2,
          "name": "❌ \"He works like a bricklayer.\""
        },
        {
          "text": "✅ \"He works as a bricklayer.\"",
          "depth": 2,
          "name": "✅ \"He works as a bricklayer.\""
        },
        {
          "text": "Use 'as' for someone's actual job or role: 'He works as a plumber.' Use 'like' for comparison: 'He works like a machine' (metaphor).",
          "depth": 2,
          "name": "Use 'as' for someone's actual job or role: 'He works as a plumber.' Use 'like' for comparison: 'He works like a machine' (metaphor)."
        },
        {
          "text": "❌ \"The crane is very high. I'm afraid of highs.\"",
          "depth": 2,
          "name": "❌ \"The crane is very high. I'm afraid of highs.\""
        },
        {
          "text": "✅ \"The crane is very tall. I'm afraid of heights.\"",
          "depth": 2,
          "name": "✅ \"The crane is very tall. I'm afraid of heights.\""
        },
        {
          "text": "Buildings and cranes are 'tall' (not 'high'). The fear is 'heights' (noun) — 'afraid of heights'. 'High' is the adjective for position: 'The bird flew high.'",
          "depth": 2,
          "name": "Buildings and cranes are 'tall' (not 'high'). The fear is 'heights' (noun) — 'afraid of heights'. 'High' is the adjective for position: 'The bird flew high.'"
        },
        {
          "text": "❌ \"They builded the house in six months.\"",
          "depth": 2,
          "name": "❌ \"They builded the house in six months.\""
        },
        {
          "text": "✅ \"They built the house in six months.\"",
          "depth": 2,
          "name": "✅ \"They built the house in six months.\""
        },
        {
          "text": "'Build' is irregular: build–built–built. There is no 'builded'.",
          "depth": 2,
          "name": "'Build' is irregular: build–built–built. There is no 'builded'."
        },
        {
          "text": "❌ \"The workers use a lot of equipments.\"",
          "depth": 2,
          "name": "❌ \"The workers use a lot of equipments.\""
        },
        {
          "text": "✅ \"The workers use a lot of equipment.\"",
          "depth": 2,
          "name": "✅ \"The workers use a lot of equipment.\""
        },
        {
          "text": "'Equipment' is uncountable — no plural 's'. Say 'pieces of equipment' or 'items of equipment' for individual things.",
          "depth": 2,
          "name": "'Equipment' is uncountable — no plural 's'. Say 'pieces of equipment' or 'items of equipment' for individual things."
        }
      ]
    },
