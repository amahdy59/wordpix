    "cultural-notes": {
      "nodeId": "547:2707",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "Health & Safety in the UK",
          "depth": 2,
          "name": "Health & Safety in the UK"
        },
        {
          "text": "UK construction sites are regulated by the Health and Safety Executive (HSE). Strict rules cover protective equipment, working at height, and machinery operation. 'Risk assessment' is a key term — every task must have one.",
          "depth": 2,
          "name": "UK construction sites are regulated by the Health and Safety Executive (HSE). Strict rules cover protective equipment, working at height, and machinery operation. 'Risk assessment' is a key term — every task must have one."
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Terms",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Terms"
        },
        {
          "text": "British: 'building site' / American: 'construction site' (both understood). British: 'skip' (waste container) / American: 'dumpster'. British: 'flat' / American: 'apartment'. British: 'ground floor' / American: 'first floor'.",
          "depth": 2,
          "name": "British: 'building site' / American: 'construction site' (both understood). British: 'skip' (waste container) / American: 'dumpster'. British: 'flat' / American: 'apartment'. British: 'ground floor' / American: 'first floor'."
        },
        {
          "text": "Trade Jobs",
          "depth": 2,
          "name": "Trade Jobs"
        },
        {
          "text": "In the UK, skilled trades (plumber, electrician, carpenter, bricklayer) are highly respected. Young people can train through apprenticeships — paid on-the-job training combined with college study. These roles are often well-paid.",
          "depth": 2,
          "name": "In the UK, skilled trades (plumber, electrician, carpenter, bricklayer) are highly respected. Young people can train through apprenticeships — paid on-the-job training combined with college study. These roles are often well-paid."
        },
        {
          "text": "Planning Permission",
          "depth": 2,
          "name": "Planning Permission"
        },
        {
          "text": "In the UK, you usually need 'planning permission' from the local council before building or making major changes to a property. 'Listed buildings' (historically important) have even stricter rules.",
          "depth": 2,
          "name": "In the UK, you usually need 'planning permission' from the local council before building or making major changes to a property. 'Listed buildings' (historically important) have even stricter rules."
        },
        {
          "text": "Builder's Tea",
          "depth": 2,
          "name": "Builder's Tea"
        },
        {
          "text": "'Builder's tea' is a strong cup of tea with milk and sugar — the stereotypical drink of British construction workers. It's become a cultural term for any strong, no-fuss cup of tea.",
          "depth": 2,
          "name": "'Builder's tea' is a strong cup of tea with milk and sugar — the stereotypical drink of British construction workers. It's become a cultural term for any strong, no-fuss cup of tea."
        }
      ]
    },
