    "cultural-notes": {
      "nodeId": "546:478",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "British: 'fire engine' / American: 'fire truck'. British: 'fire brigade' / American: 'fire department'. British: '999' / American: '911'. Both: 'firefighter' (gender-neutral).",
          "depth": 2,
          "name": "British: 'fire engine' / American: 'fire truck'. British: 'fire brigade' / American: 'fire department'. British: '999' / American: '911'. Both: 'firefighter' (gender-neutral)."
        },
        {
          "text": "Firefighter vs Fireman",
          "depth": 2,
          "name": "Firefighter vs Fireman"
        },
        {
          "text": "'Firefighter' is the modern, inclusive term used officially in the UK and US. 'Fireman' is outdated. Many fire services actively recruit people of all genders.",
          "depth": 2,
          "name": "'Firefighter' is the modern, inclusive term used officially in the UK and US. 'Fireman' is outdated. Many fire services actively recruit people of all genders."
        },
        {
          "text": "Fire Safety in Homes",
          "depth": 2,
          "name": "Fire Safety in Homes"
        },
        {
          "text": "UK law requires smoke alarms on every floor. Carbon monoxide detectors are required near gas appliances. Fire blankets are recommended in kitchens. These vocabulary items appear in safety leaflets.",
          "depth": 2,
          "name": "UK law requires smoke alarms on every floor. Carbon monoxide detectors are required near gas appliances. Fire blankets are recommended in kitchens. These vocabulary items appear in safety leaflets."
        },
        {
          "text": "Bonfire Night (UK)",
          "depth": 2,
          "name": "Bonfire Night (UK)"
        },
        {
          "text": "November 5th is 'Bonfire Night' or 'Guy Fawkes Night' in the UK. People light bonfires and set off fireworks. Fire safety advice is widely shared every autumn.",
          "depth": 2,
          "name": "November 5th is 'Bonfire Night' or 'Guy Fawkes Night' in the UK. People light bonfires and set off fireworks. Fire safety advice is widely shared every autumn."
        },
        {
          "text": "Volunteer Firefighters",
          "depth": 2,
          "name": "Volunteer Firefighters"
        },
        {
          "text": "In many rural areas of the US, UK, and Australia, fire brigades rely on volunteers. 'Volunteer firefighter' is a respected community role. This is good context for discussing civic vocabulary.",
          "depth": 2,
          "name": "In many rural areas of the US, UK, and Australia, fire brigades rely on volunteers. 'Volunteer firefighter' is a respected community role. This is good context for discussing civic vocabulary."
        }
      ]
    },
