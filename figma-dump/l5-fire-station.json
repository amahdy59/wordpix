    "common-mistakes": {
      "nodeId": "546:376",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"The firemen put off the fire.\"",
          "depth": 2,
          "name": "❌ \"The firemen put off the fire.\""
        },
        {
          "text": "✅ \"The firefighters put out the fire.\"",
          "depth": 2,
          "name": "✅ \"The firefighters put out the fire.\""
        },
        {
          "text": "'Put out' = extinguish. 'Put off' = postpone or delay. Also, 'firefighters' is the modern, gender-neutral term.",
          "depth": 2,
          "name": "'Put out' = extinguish. 'Put off' = postpone or delay. Also, 'firefighters' is the modern, gender-neutral term."
        },
        {
          "text": "❌ \"Call the fire brigade! There is a fire!\" (correct, but also:)",
          "depth": 2,
          "name": "❌ \"Call the fire brigade! There is a fire!\" (correct, but also:)"
        },
        {
          "text": "✅ \"Call 999/911! There is a fire!\"",
          "depth": 2,
          "name": "✅ \"Call 999/911! There is a fire!\""
        },
        {
          "text": "Both are correct. In emergencies, calling the emergency number (999 UK, 911 US) connects you to all services.",
          "depth": 2,
          "name": "Both are correct. In emergencies, calling the emergency number (999 UK, 911 US) connects you to all services."
        },
        {
          "text": "❌ \"The building is on fire since one hour.\"",
          "depth": 2,
          "name": "❌ \"The building is on fire since one hour.\""
        },
        {
          "text": "✅ \"The building has been on fire for one hour.\"",
          "depth": 2,
          "name": "✅ \"The building has been on fire for one hour.\""
        },
        {
          "text": "Use 'for' + duration with present perfect. 'Since' needs a point in time.",
          "depth": 2,
          "name": "Use 'for' + duration with present perfect. 'Since' needs a point in time."
        },
        {
          "text": "❌ \"He wears a fire uniform.\"",
          "depth": 2,
          "name": "❌ \"He wears a fire uniform.\""
        },
        {
          "text": "✅ \"He wears a firefighter's uniform.\" / \"He wears protective gear.\"",
          "depth": 2,
          "name": "✅ \"He wears a firefighter's uniform.\" / \"He wears protective gear.\""
        },
        {
          "text": "'Fire uniform' is not natural. Use 'firefighter's uniform', 'fire kit', or 'protective gear/clothing'.",
          "depth": 2,
          "name": "'Fire uniform' is not natural. Use 'firefighter's uniform', 'fire kit', or 'protective gear/clothing'."
        },
        {
          "text": "❌ \"The alarm ringed loudly.\"",
          "depth": 2,
          "name": "❌ \"The alarm ringed loudly.\""
        },
        {
          "text": "✅ \"The alarm rang loudly.\"",
          "depth": 2,
          "name": "✅ \"The alarm rang loudly.\""
        },
        {
          "text": "'Ring' is irregular: ring–rang–rung. There is no 'ringed' in this context.",
          "depth": 2,
          "name": "'Ring' is irregular: ring–rang–rung. There is no 'ringed' in this context."
        }
      ]
    },
