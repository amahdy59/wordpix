        {
          "text": "Waiter:",
          "depth": 2,
          "name": "Waiter:"
        },
        {
          "text": "Good evening. Are you ready to order?",
          "depth": 2,
          "name": "Good evening. Are you ready to order?"
        },
        {
          "text": "Guest:",
          "depth": 2,
          "name": "Guest:"
        },
        {
          "text": "Yes, I think so. Could I have the tomato soup as a starter?",
          "depth": 2,
          "name": "Yes, I think so. Could I have the tomato soup as a starter?"
        },
        {
          "text": "Waiter:",
          "depth": 2,
          "name": "Waiter:"
        },
        {
          "text": "Of course. And for the main course?",
          "depth": 2,
          "name": "Of course. And for the main course?"
        },
        {
          "text": "Guest:",
          "depth": 2,
          "name": "Guest:"
        },
        {
          "text": "I'd like the grilled salmon with rice, please. Is the fish fresh?",
          "depth": 2,
          "name": "I'd like the grilled salmon with rice, please. Is the fish fresh?"
        },
        {
          "text": "Waiter:",
          "depth": 2,
          "name": "Waiter:"
        },
        {
          "text": "Yes, it's delivered daily. Would you like anything to drink?",
          "depth": 2,
          "name": "Yes, it's delivered daily. Would you like anything to drink?"
        },
        {
          "text": "Guest:",
          "depth": 2,
          "name": "Guest:"
        },
        {
          "text": "Just water, please. Sparkling, if you have it.",
          "depth": 2,
          "name": "Just water, please. Sparkling, if you have it."
        },
        {
          "text": "Waiter:",
          "depth": 2,
          "name": "Waiter:"
        },
        {
          "text": "Certainly. And for dessert?",
          "depth": 2,
          "name": "Certainly. And for dessert?"
        },
        {
          "text": "Guest:",
          "depth": 2,
          "name": "Guest:"
        },
        {
          "text": "I'll decide after the main course, if that's okay.",
          "depth": 2,
          "name": "I'll decide after the main course, if that's okay."
        },
        {
          "text": "Waiter:",
          "depth": 2,
          "name": "Waiter:"
        },
        {
          "text": "No problem. I'll bring your starter shortly.",
