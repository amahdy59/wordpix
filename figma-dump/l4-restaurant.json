    "common-mistakes": {
      "nodeId": "544:925",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"I want to eat a dinner in a restaurant.\"",
          "depth": 2,
          "name": "❌ \"I want to eat a dinner in a restaurant.\""
        },
        {
          "text": "✅ \"I want to have dinner at a restaurant.\"",
          "depth": 2,
          "name": "✅ \"I want to have dinner at a restaurant.\""
        },
        {
          "text": "'Have dinner' is the natural collocation. Use 'at a restaurant', not 'in'. No article before 'dinner' when it's the meal in general.",
          "depth": 2,
          "name": "'Have dinner' is the natural collocation. Use 'at a restaurant', not 'in'. No article before 'dinner' when it's the meal in general."
        },
        {
          "text": "❌ \"The bill, please.\" (While this works, a more polite version:)",
          "depth": 2,
          "name": "❌ \"The bill, please.\" (While this works, a more polite version:)"
        },
        {
          "text": "✅ \"Could we have the bill, please?\" / \"Could I get the check?\"",
          "depth": 2,
          "name": "✅ \"Could we have the bill, please?\" / \"Could I get the check?\""
        },
        {
          "text": "Adding 'Could we/I' makes the request more polite in English. Americans say 'check'; British say 'bill'.",
          "depth": 2,
          "name": "Adding 'Could we/I' makes the request more polite in English. Americans say 'check'; British say 'bill'."
        },
        {
          "text": "❌ \"I would like to command the fish.\"",
          "depth": 2,
          "name": "❌ \"I would like to command the fish.\""
        },
        {
          "text": "✅ \"I would like to order the fish.\"",
          "depth": 2,
          "name": "✅ \"I would like to order the fish.\""
        },
        {
          "text": "In English, you 'order' food at a restaurant. 'Command' means to give an order with authority — very different!",
          "depth": 2,
          "name": "In English, you 'order' food at a restaurant. 'Command' means to give an order with authority — very different!"
        },
        {
          "text": "❌ \"The food was very delicious and the service very good.\"",
          "depth": 2,
          "name": "❌ \"The food was very delicious and the service very good.\""
        },
        {
          "text": "✅ \"The food was delicious and the service was excellent.\"",
          "depth": 2,
          "name": "✅ \"The food was delicious and the service was excellent.\""
        },
        {
          "text": "'Delicious' and 'excellent' are already strong — avoid 'very'. Use 'absolutely' for emphasis if needed.",
          "depth": 2,
          "name": "'Delicious' and 'excellent' are already strong — avoid 'very'. Use 'absolutely' for emphasis if needed."
        },
        {
          "text": "❌ \"We are four persons for dinner.\"",
          "depth": 2,
          "name": "❌ \"We are four persons for dinner.\""
        },
        {
          "text": "✅ \"There are four of us.\" / \"A table for four, please.\"",
          "depth": 2,
          "name": "✅ \"There are four of us.\" / \"A table for four, please.\""
        },
        {
          "text": "'Persons' is very formal. Use 'people', 'of us', or 'a table for [number]' in restaurant contexts.",
          "depth": 2,
          "name": "'Persons' is very formal. Use 'people', 'of us', or 'a table for [number]' in restaurant contexts."
        }
      ]
    },
