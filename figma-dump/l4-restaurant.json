    "cultural-notes": {
      "nodeId": "544:1027",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "Tipping Culture",
          "depth": 2,
          "name": "Tipping Culture"
        },
        {
          "text": "In the US, tipping 15–20% is expected. In the UK, 10–12.5% is normal but not always required. Some restaurants add a 'service charge' to the bill automatically. Always check before tipping.",
          "depth": 2,
          "name": "In the US, tipping 15–20% is expected. In the UK, 10–12.5% is normal but not always required. Some restaurants add a 'service charge' to the bill automatically. Always check before tipping."
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "British: 'bill' / American: 'check'. British: 'starter' / American: 'appetizer'. British: 'main course' / American: 'entrée'. British: 'chips' / American: 'fries'. British: 'takeaway' / American: 'takeout'.",
          "depth": 2,
          "name": "British: 'bill' / American: 'check'. British: 'starter' / American: 'appetizer'. British: 'main course' / American: 'entrée'. British: 'chips' / American: 'fries'. British: 'takeaway' / American: 'takeout'."
        },
        {
          "text": "Dietary Requirements",
          "depth": 2,
          "name": "Dietary Requirements"
        },
        {
          "text": "Restaurants in English-speaking countries expect dietary questions: 'Is this gluten-free?', 'Do you have vegan options?', 'Does this contain nuts?' Knowing these phrases is practical.",
          "depth": 2,
          "name": "Restaurants in English-speaking countries expect dietary questions: 'Is this gluten-free?', 'Do you have vegan options?', 'Does this contain nuts?' Knowing these phrases is practical."
        },
        {
          "text": "Saying 'Please' and 'Thank You'",
          "depth": 2,
          "name": "Saying 'Please' and 'Thank You'"
        },
        {
          "text": "Politeness is essential when ordering. Always say 'please' when ordering and 'thank you' when served. Using 'Could I have...' or 'I'd like...' is more polite than 'I want...' or 'Give me...'.",
          "depth": 2,
          "name": "Politeness is essential when ordering. Always say 'please' when ordering and 'thank you' when served. Using 'Could I have...' or 'I'd like...' is more polite than 'I want...' or 'Give me...'."
        },
        {
          "text": "Course Order",
          "depth": 2,
          "name": "Course Order"
        },
        {
          "text": "A formal English meal follows this order: starter (appetizer) → main course (entrée) → dessert (sweet). Some add 'amuse-bouche' before starters or 'cheese course' before dessert.",
          "depth": 2,
          "name": "A formal English meal follows this order: starter (appetizer) → main course (entrée) → dessert (sweet). Some add 'amuse-bouche' before starters or 'cheese course' before dessert."
        }
      ]
    },
