    "mini-dialogue": {
      "nodeId": "542:2818",
      "lines": [
        {
          "text": "🗣️ Mini Dialogue",
          "depth": 1,
          "name": "🗣️ Mini Dialogue"
        },
        {
          "text": "Scene: A farmer gives a tour of the farm to a group of visitors",
          "depth": 1,
          "name": "Scene: A farmer gives a tour of the farm to a group of visitors"
        },
        {
          "text": "Farmer:",
          "depth": 2,
          "name": "Farmer:"
        },
        {
          "text": "Welcome to the farm! Over here we have the cow barn. We milk the cows every morning.",
          "depth": 2,
          "name": "Welcome to the farm! Over here we have the cow barn. We milk the cows every morning."
        },
        {
          "text": "Visitor 1:",
          "depth": 2,
          "name": "Visitor 1:"
        },
        {
          "text": "How many animals do you have? I can see a horse, some sheep, and a goat near the fence.",
          "depth": 2,
          "name": "How many animals do you have? I can see a horse, some sheep, and a goat near the fence."
        },
        {
          "text": "Farmer:",
          "depth": 2,
          "name": "Farmer:"
        },
        {
          "text": "We have about fifty animals. The pig pen is behind the barn, and the chicken coop is next to the wheat field.",
          "depth": 2,
          "name": "We have about fifty animals. The pig pen is behind the barn, and the chicken coop is next to the wheat field."
        },
        {
          "text": "Visitor 2:",
          "depth": 2,
          "name": "Visitor 2:"
        },
        {
          "text": "What do the chickens eat? I see a rooster and several hens walking around.",
          "depth": 2,
          "name": "What do the chickens eat? I see a rooster and several hens walking around."
        },
        {
          "text": "Farmer:",
          "depth": 2,
          "name": "Farmer:"
        },
        {
          "text": "They eat corn and grain. The hen lays eggs every day, and the rooster wakes us at dawn.",
          "depth": 2,
          "name": "They eat corn and grain. The hen lays eggs every day, and the rooster wakes us at dawn."
        },
        {
          "text": "Visitor 1:",
          "depth": 2,
          "name": "Visitor 1:"
        },
        {
          "text": "What crops do you grow? I noticed a big field of potato and tomato plants.",
          "depth": 2,
          "name": "What crops do you grow? I noticed a big field of potato and tomato plants."
        },
        {
          "text": "Farmer:",
          "depth": 2,
          "name": "Farmer:"
        },
        {
          "text": "We grow carrot, lettuce, onion, pumpkin, bean, pea, cabbage, and beetroot — everything for the local market.",
          "depth": 2,
          "name": "We grow carrot, lettuce, onion, pumpkin, bean, pea, cabbage, and beetroot — everything for the local market."
        },
        {
          "text": "Visitor 2:",
          "depth": 2,
          "name": "Visitor 2:"
        },
        {
          "text": "And the fruit trees? I can see an apple tree and a cherry tree over there.",
          "depth": 2,
          "name": "And the fruit trees? I can see an apple tree and a cherry tree over there."
        },
        {
          "text": "Farmer:",
          "depth": 2,
          "name": "Farmer:"
        },
        {
          "text": "Yes — we also have a pear tree, an orange tree, and a peach tree. The strawberry and blueberry bushes are behind the duck pond.",
          "depth": 2,
          "name": "Yes — we also have a pear tree, an orange tree, and a peach tree. The strawberry and blueberry bushes are behind the duck pond."
        },
        {
          "text": "Visitor 1:",
          "depth": 2,
          "name": "Visitor 1:"
        },
        {
          "text": "Is that a turkey next to the donkey? They seem like an odd pair.",
          "depth": 2,
          "name": "Is that a turkey next to the donkey? They seem like an odd pair."
        }
      ]
