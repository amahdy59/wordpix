    "common-mistakes": {
      "nodeId": "542:2853",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"The farmer grows animals.\"",
          "depth": 2,
          "name": "❌ \"The farmer grows animals.\""
        },
        {
          "text": "✅ \"The farmer raises / keeps animals.\"",
          "depth": 2,
          "name": "✅ \"The farmer raises / keeps animals.\""
        },
        {
          "text": "'Grow' is for plants and crops. 'Raise' or 'keep' is for animals.",
          "depth": 2,
          "name": "'Grow' is for plants and crops. 'Raise' or 'keep' is for animals."
        },
        {
          "text": "❌ \"The sheep is eating grasses.\"",
          "depth": 2,
          "name": "❌ \"The sheep is eating grasses.\""
        },
        {
          "text": "✅ \"The sheep is eating grass.\"",
          "depth": 2,
          "name": "✅ \"The sheep is eating grass.\""
        },
        {
          "text": "'Grass' is uncountable in this context. 'Grasses' refers to different species of grass (scientific).",
          "depth": 2,
          "name": "'Grass' is uncountable in this context. 'Grasses' refers to different species of grass (scientific)."
        },
        {
          "text": "❌ \"He feeded the chickens this morning.\"",
          "depth": 2,
          "name": "❌ \"He feeded the chickens this morning.\""
        },
        {
          "text": "✅ \"He fed the chickens this morning.\"",
          "depth": 2,
          "name": "✅ \"He fed the chickens this morning.\""
        },
        {
          "text": "'Feed' is irregular: feed–fed–fed. There is no 'feeded'.",
          "depth": 2,
          "name": "'Feed' is irregular: feed–fed–fed. There is no 'feeded'."
        },
        {
          "text": "❌ \"There are many sheeps on the farm.\"",
          "depth": 2,
          "name": "❌ \"There are many sheeps on the farm.\""
        },
        {
          "text": "✅ \"There are many sheep on the farm.\"",
          "depth": 2,
          "name": "✅ \"There are many sheep on the farm.\""
        },
        {
          "text": "'Sheep' is the same in singular and plural: one sheep, ten sheep. Same for 'fish' and 'deer'.",
          "depth": 2,
          "name": "'Sheep' is the same in singular and plural: one sheep, ten sheep. Same for 'fish' and 'deer'."
        },
        {
          "text": "❌ \"The cow gives us a milk.\"",
          "depth": 2,
          "name": "❌ \"The cow gives us a milk.\""
        },
        {
          "text": "✅ \"The cow gives us milk.\"",
          "depth": 2,
          "name": "✅ \"The cow gives us milk.\""
        },
        {
          "text": "'Milk' is uncountable — no 'a'. Say 'some milk', 'a glass of milk', or 'a bottle of milk'.",
          "depth": 2,
          "name": "'Milk' is uncountable — no 'a'. Say 'some milk', 'a glass of milk', or 'a bottle of milk'."
        }
      ]
    },
