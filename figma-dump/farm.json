        {
          "text": "🗣️ Mini Dialogue",
          "depth": 1,
          "name": "🗣️ Mini Dialogue"
        },
        {
          "text": "Scene: A city child visiting a farm for the first time",
          "depth": 1,
          "name": "Scene: A city child visiting a farm for the first time"
        },
        {
          "text": "Kareem:",
          "depth": 2,
          "name": "Kareem:"
        },
        {
          "text": "Wow, this farm is huge! What do we do first?",
          "depth": 2,
          "name": "Wow, this farm is huge! What do we do first?"
        },
        {
          "text": "Uncle:",
          "depth": 2,
          "name": "Uncle:"
        },
        {
          "text": "Let's feed the chickens. Grab that bucket of grain.",
          "depth": 2,
          "name": "Let's feed the chickens. Grab that bucket of grain."
        },
        {
          "text": "Kareem:",
          "depth": 2,
          "name": "Kareem:"
        },
        {
          "text": "They're so fast! How many eggs do they lay each day?",
          "depth": 2,
          "name": "They're so fast! How many eggs do they lay each day?"
        },
        {
          "text": "Uncle:",
          "depth": 2,
          "name": "Uncle:"
        },
        {
          "text": "About fifteen to twenty. You can collect them from the hen house later.",
          "depth": 2,
          "name": "About fifteen to twenty. You can collect them from the hen house later."
        },
        {
          "text": "Kareem:",
          "depth": 2,
          "name": "Kareem:"
        },
        {
          "text": "What about the cows? Can I try milking one?",
          "depth": 2,
          "name": "What about the cows? Can I try milking one?"
        },
        {
          "text": "Uncle:",
          "depth": 2,
          "name": "Uncle:"
        },
        {
          "text": "Sure, but you need to be gentle. Sit on the stool and pull slowly.",
          "depth": 2,
          "name": "Sure, but you need to be gentle. Sit on the stool and pull slowly."
        },
        {
          "text": "Kareem:",
          "depth": 2,
          "name": "Kareem:"
        },
        {
          "text": "This is harder than it looks! What's in that big building?",
          "depth": 2,
          "name": "This is harder than it looks! What's in that big building?"
        },
        {
          "text": "Uncle:",
          "depth": 2,
          "name": "Uncle:"
        },
        {
          "text": "That's the barn. We store hay and equipment there.",
          "depth": 2,
          "name": "That's the barn. We store hay and equipment there."
        },
        {
          "text": "Kareem:",
          "depth": 2,
          "name": "Kareem:"
        },
        {
          "text": "And what's that machine in the field?",
          "depth": 2,
          "name": "And what's that machine in the field?"
        },
        {
          "text": "Uncle:",
          "depth": 2,
          "name": "Uncle:"
        },
        {
          "text": "That's the tractor. After lunch, I'll teach you how to drive it.",
          "depth": 2,
          "name": "That's the tractor. After lunch, I'll teach you how to drive it."
        }
      ]
