    "cultural-notes": {
      "nodeId": "542:2955",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "Farm vs Ranch",
          "depth": 2,
          "name": "Farm vs Ranch"
        },
        {
          "text": "In British English, 'farm' is the universal term. In American English, a 'ranch' specifically raises cattle or horses on large open land, while a 'farm' grows crops or keeps smaller animals.",
          "depth": 2,
          "name": "In British English, 'farm' is the universal term. In American English, a 'ranch' specifically raises cattle or horses on large open land, while a 'farm' grows crops or keeps smaller animals."
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "British: 'plough' / American: 'plow'. British: 'maize' / American: 'corn'. British: 'cockerel' / American: 'rooster'. British: 'tyre' / American: 'tire' (on the tractor).",
          "depth": 2,
          "name": "British: 'plough' / American: 'plow'. British: 'maize' / American: 'corn'. British: 'cockerel' / American: 'rooster'. British: 'tyre' / American: 'tire' (on the tractor)."
        },
        {
          "text": "Animal Sounds in English",
          "depth": 2,
          "name": "Animal Sounds in English"
        },
        {
          "text": "English animal sounds are specific: cows 'moo', sheep 'baa', chickens 'cluck', pigs 'oink', horses 'neigh', dogs 'bark', roosters 'cock-a-doodle-doo'. These appear in children's books and nursery rhymes.",
          "depth": 2,
          "name": "English animal sounds are specific: cows 'moo', sheep 'baa', chickens 'cluck', pigs 'oink', horses 'neigh', dogs 'bark', roosters 'cock-a-doodle-doo'. These appear in children's books and nursery rhymes."
        },
        {
          "text": "Collective Nouns for Animals",
          "depth": 2,
          "name": "Collective Nouns for Animals"
        },
        {
          "text": "English uses special group words: 'a herd of cows', 'a flock of sheep', 'a litter of piglets', 'a pack of dogs'. Using the wrong collective noun sounds unnatural.",
          "depth": 2,
          "name": "English uses special group words: 'a herd of cows', 'a flock of sheep', 'a litter of piglets', 'a pack of dogs'. Using the wrong collective noun sounds unnatural."
        },
        {
          "text": "Farm-to-Table Movement",
          "depth": 2,
          "name": "Farm-to-Table Movement"
        },
        {
          "text": "'Farm-to-table' or 'farm-to-fork' describes food that goes directly from the farm to the consumer. It's a growing trend in restaurants and supermarkets across English-speaking countries.",
          "depth": 2,
