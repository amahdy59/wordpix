    "cultural-notes": {
      "nodeId": "542:2119",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "🇬🇧 Garden vs 🇺🇸 Yard",
          "depth": 2,
          "name": "🇬🇧 Garden vs 🇺🇸 Yard"
        },
        {
          "text": "In British English, 'garden' means the outdoor space around a house (front garden, back garden). In American English, 'yard' is more common for the grass area, while 'garden' means a planted area with flowers or vegetables.",
          "depth": 2,
          "name": "In British English, 'garden' means the outdoor space around a house (front garden, back garden). In American English, 'yard' is more common for the grass area, while 'garden' means a planted area with flowers or vegetables."
        },
        {
          "text": "Allotments (UK Culture)",
          "depth": 2,
          "name": "Allotments (UK Culture)"
        },
        {
          "text": "In Britain, 'allotments' are small plots of land rented by people to grow food. They are very popular and often have long waiting lists. This concept is less common in North America.",
          "depth": 2,
          "name": "In Britain, 'allotments' are small plots of land rented by people to grow food. They are very popular and often have long waiting lists. This concept is less common in North America."
        },
        {
          "text": "Garden Centre vs Nursery",
          "depth": 2,
          "name": "Garden Centre vs Nursery"
        },
        {
          "text": "A 'garden centre' sells plants, tools, pots, and garden furniture. A 'nursery' specifically grows and sells young plants and seedlings. Both terms are widely used.",
          "depth": 2,
          "name": "A 'garden centre' sells plants, tools, pots, and garden furniture. A 'nursery' specifically grows and sells young plants and seedlings. Both terms are widely used."
        },
        {
          "text": "Lawn Care Vocabulary",
          "depth": 2,
          "name": "Lawn Care Vocabulary"
        },
        {
          "text": "English has specific words: 'mow the lawn' (cut grass), 'trim the hedge', 'prune the roses', 'rake the leaves'. Using the right verb for each garden task is important.",
          "depth": 2,
          "name": "English has specific words: 'mow the lawn' (cut grass), 'trim the hedge', 'prune the roses', 'rake the leaves'. Using the right verb for each garden task is important."
        },
        {
          "text": "Composting as a Green Topic",
          "depth": 2,
          "name": "Composting as a Green Topic"
        },
        {
          "text": "Composting is a popular topic in English-speaking countries. Words like 'recycle', 'organic waste', 'biodegradable', and 'sustainability' often appear alongside garden vocabulary.",
          "depth": 2,
          "name": "Composting is a popular topic in English-speaking countries. Words like 'recycle', 'organic waste', 'biodegradable', and 'sustainability' often appear alongside garden vocabulary."
        }
      ]
    },
