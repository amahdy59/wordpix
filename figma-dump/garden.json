    "mini-dialogue": {
      "nodeId": "542:1982",
      "lines": [
        {
          "text": "🗣️ Mini Dialogue",
          "depth": 1,
          "name": "🗣️ Mini Dialogue"
        },
        {
          "text": "Scene: Neighbours chatting over the garden fence",
          "depth": 1,
          "name": "Scene: Neighbours chatting over the garden fence"
        },
        {
          "text": "Ali:",
          "depth": 2,
          "name": "Ali:"
        },
        {
          "text": "Your garden looks wonderful this year! How do you keep it so green?",
          "depth": 2,
          "name": "Your garden looks wonderful this year! How do you keep it so green?"
        },
        {
          "text": "Mrs B:",
          "depth": 2,
          "name": "Mrs B:"
        },
        {
          "text": "Thank you! I water the lawn every morning and add fertiliser once a month.",
          "depth": 2,
          "name": "Thank you! I water the lawn every morning and add fertiliser once a month."
        },
        {
          "text": "Ali:",
          "depth": 2,
          "name": "Ali:"
        },
        {
          "text": "I tried growing tomatoes last summer, but they didn't survive.",
          "depth": 2,
          "name": "I tried growing tomatoes last summer, but they didn't survive."
        },
        {
          "text": "Mrs B:",
          "depth": 2,
          "name": "Mrs B:"
        },
        {
          "text": "Did you use good soil? Tomatoes need rich compost and plenty of sunlight.",
          "depth": 2,
          "name": "Did you use good soil? Tomatoes need rich compost and plenty of sunlight."
        },
        {
          "text": "Ali:",
          "depth": 2,
          "name": "Ali:"
        },
        {
          "text": "I think the soil was too dry. I didn't water them enough.",
          "depth": 2,
          "name": "I think the soil was too dry. I didn't water them enough."
        },
        {
          "text": "Mrs B:",
          "depth": 2,
          "name": "Mrs B:"
        },
        {
          "text": "That's probably it. You should also use a sprinkler or a drip hose — it saves time.",
          "depth": 2,
          "name": "That's probably it. You should also use a sprinkler or a drip hose — it saves time."
        },
        {
          "text": "Ali:",
          "depth": 2,
          "name": "Ali:"
        },
        {
          "text": "What about weeds? They keep taking over my flower beds.",
          "depth": 2,
          "name": "What about weeds? They keep taking over my flower beds."
        },
        {
          "text": "Mrs B:",
          "depth": 2,
          "name": "Mrs B:"
        },
        {
          "text": "Pull them out early, before they spread. A small trowel helps a lot.",
          "depth": 2,
          "name": "Pull them out early, before they spread. A small trowel helps a lot."
        },
        {
          "text": "Ali:",
          "depth": 2,
          "name": "Ali:"
        },
        {
          "text": "Do you grow anything in winter?",
          "depth": 2,
          "name": "Do you grow anything in winter?"
        },
        {
          "text": "Mrs B:",
          "depth": 2,
          "name": "Mrs B:"
        },
        {
          "text": "Yes, I use the greenhouse for herbs. Basil and mint grow all year if you keep it warm.",
          "depth": 2,
          "name": "Yes, I use the greenhouse for herbs. Basil and mint grow all year if you keep it warm."
        }
      ]
    },
    "common-mistakes": {
      "nodeId": "542:2017",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"I planted a seed in the earth.\"",
          "depth": 2,
          "name": "❌ \"I planted a seed in the earth.\""
        },
        {
          "text": "✅ \"I planted a seed in the soil.\" (or 'ground')",
          "depth": 2,
          "name": "✅ \"I planted a seed in the soil.\" (or 'ground')"
        },
        {
          "text": "While 'earth' can mean soil, 'soil' is the standard word for gardening. 'Earth' usually means the planet.",
          "depth": 2,
          "name": "While 'earth' can mean soil, 'soil' is the standard word for gardening. 'Earth' usually means the planet."
        },
        {
          "text": "❌ \"The flowers are died.\"",
          "depth": 2,
          "name": "❌ \"The flowers are died.\""
        },
        {
          "text": "✅ \"The flowers are dead.\" / \"The flowers have died.\"",
          "depth": 2,
          "name": "✅ \"The flowers are dead.\" / \"The flowers have died.\""
        },
        {
          "text": "'Dead' is the adjective. 'Died' is the past tense verb. Use 'have died' for present perfect.",
          "depth": 2,
          "name": "'Dead' is the adjective. 'Died' is the past tense verb. Use 'have died' for present perfect."
        },
        {
          "text": "❌ \"I water the plants since morning.\"",
          "depth": 2,
          "name": "❌ \"I water the plants since morning.\""
        },
        {
          "text": "✅ \"I have been watering the plants since morning.\"",
          "depth": 2,
          "name": "✅ \"I have been watering the plants since morning.\""
        },
        {
          "text": "Use present perfect continuous ('have been + -ing') with 'since' for actions still happening.",
          "depth": 2,
          "name": "Use present perfect continuous ('have been + -ing') with 'since' for actions still happening."
        },
        {
          "text": "❌ \"She grows vegetables on her garden.\"",
          "depth": 2,
          "name": "❌ \"She grows vegetables on her garden.\""
        },
        {
          "text": "✅ \"She grows vegetables in her garden.\"",
          "depth": 2,
          "name": "✅ \"She grows vegetables in her garden.\""
        },
        {
          "text": "Use 'in the garden' (enclosed area), not 'on'. 'On' is used for surfaces like 'on the balcony'.",
          "depth": 2,
          "name": "Use 'in the garden' (enclosed area), not 'on'. 'On' is used for surfaces like 'on the balcony'."
        },
        {
          "text": "❌ \"I cutted the grass yesterday.\"",
          "depth": 2,
          "name": "❌ \"I cutted the grass yesterday.\""
        },
        {
          "text": "✅ \"I cut the grass yesterday.\"",
          "depth": 2,
          "name": "✅ \"I cut the grass yesterday.\""
        },
        {
          "text": "'Cut' is an irregular verb — the past tense is also 'cut' (cut–cut–cut), not 'cutted'.",
          "depth": 2,
          "name": "'Cut' is an irregular verb — the past tense is also 'cut' (cut–cut–cut), not 'cutted'."
        }
      ]
    },
