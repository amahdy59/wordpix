        {
          "text": "🗣️ Mini Dialogue",
          "depth": 1,
          "name": "🗣️ Mini Dialogue"
        },
        {
          "text": "Scene: A cooking lesson between two friends",
          "depth": 1,
          "name": "Scene: A cooking lesson between two friends"
        },
        {
          "text": "Liam:",
          "depth": 2,
          "name": "Liam:"
        },
        {
          "text": "Okay, first we need to heat up the frying pan. Can you pass me the spatula?",
          "depth": 2,
          "name": "Okay, first we need to heat up the frying pan. Can you pass me the spatula?"
        },
        {
          "text": "Noor:",
          "depth": 2,
          "name": "Noor:"
        },
        {
          "text": "Sure. Should I chop the onions? Where's the cutting board?",
          "depth": 2,
          "name": "Sure. Should I chop the onions? Where's the cutting board?"
        },
        {
          "text": "Liam:",
          "depth": 2,
          "name": "Liam:"
        },
        {
          "text": "It's next to the sink. Use the sharp knife — and grab the peeler for the carrots too.",
          "depth": 2,
          "name": "It's next to the sink. Use the sharp knife — and grab the peeler for the carrots too."
        },
        {
          "text": "Noor:",
          "depth": 2,
          "name": "Noor:"
        },
        {
          "text": "Got it. Do you want me to boil water for the pasta?",
          "depth": 2,
          "name": "Got it. Do you want me to boil water for the pasta?"
        },
        {
          "text": "Liam:",
          "depth": 2,
          "name": "Liam:"
        },
        {
          "text": "Yes, fill the large pot and put it on the back burner. Add a pinch of salt.",
          "depth": 2,
          "name": "Yes, fill the large pot and put it on the back burner. Add a pinch of salt."
        },
        {
          "text": "Noor:",
          "depth": 2,
          "name": "Noor:"
        },
        {
          "text": "Done. What about the sauce?",
          "depth": 2,
          "name": "Done. What about the sauce?"
        },
        {
          "text": "Liam:",
          "depth": 2,
          "name": "Liam:"
        },
        {
          "text": "I'll make it in the saucepan. I just need the ladle, the whisk, and some garlic from the refrigerator.",
          "depth": 2,
          "name": "I'll make it in the saucepan. I just need the ladle, the whisk, and some garlic from the refrigerator."
        },
        {
          "text": "Noor:",
          "depth": 2,
          "name": "Noor:"
        },
        {
          "text": "The blender is on the counter — do you need it for the sauce?",
          "depth": 2,
          "name": "The blender is on the counter — do you need it for the sauce?"
        },
        {
          "text": "Liam:",
          "depth": 2,
          "name": "Liam:"
        },
        {
          "text": "No, I'll keep it chunky. Can you set the oven to 180 degrees? We're baking the garlic bread.",
          "depth": 2,
          "name": "No, I'll keep it chunky. Can you set the oven to 180 degrees? We're baking the garlic bread."
        },
        {
          "text": "Noor:",
          "depth": 2,
          "name": "Noor:"
        },
        {
          "text": "Sure. Cooking together is actually fun — I should do this more often!",
          "depth": 2,
          "name": "Sure. Cooking together is actually fun — I should do this more often!"
        }
      ]
