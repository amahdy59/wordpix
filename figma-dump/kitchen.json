    "cultural-notes": {
      "nodeId": "542:1567",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "British: \"hob\" / American: \"stove\" or \"burner\". British: \"grill\" (inside oven) / American: \"broiler\". British: \"cling film\" / American: \"plastic wrap\". British: \"tin\" / American: \"can\".",
          "depth": 2,
          "name": "British: \"hob\" / American: \"stove\" or \"burner\". British: \"grill\" (inside oven) / American: \"broiler\". British: \"cling film\" / American: \"plastic wrap\". British: \"tin\" / American: \"can\"."
        },
        {
          "text": "Kitchen Measurements",
          "depth": 2,
          "name": "Kitchen Measurements"
        },
        {
          "text": "British recipes use grams (g) and millilitres (ml). American recipes use cups, tablespoons (tbsp), and teaspoons (tsp). 'A pinch of salt' means a very small amount you can hold between two fingers.",
          "depth": 2,
          "name": "British recipes use grams (g) and millilitres (ml). American recipes use cups, tablespoons (tbsp), and teaspoons (tsp). 'A pinch of salt' means a very small amount you can hold between two fingers."
        },
        {
          "text": "Cooking Verbs Are Specific",
          "depth": 2,
          "name": "Cooking Verbs Are Specific"
        },
        {
          "text": "English has many precise cooking verbs: chop (rough pieces), dice (small cubes), slice (thin flat pieces), mince (very fine), julienne (thin strips). Using the right verb shows cooking fluency.",
          "depth": 2,
          "name": "English has many precise cooking verbs: chop (rough pieces), dice (small cubes), slice (thin flat pieces), mince (very fine), julienne (thin strips). Using the right verb shows cooking fluency."
        },
        {
          "text": "'Do the dishes' vs 'Wash up'",
          "depth": 2,
          "name": "'Do the dishes' vs 'Wash up'"
        },
        {
          "text": "In American English, 'do the dishes' or 'wash the dishes' is standard. In British English, 'wash up' means the same thing — but in American English, 'wash up' means wash your hands!",
          "depth": 2,
          "name": "In American English, 'do the dishes' or 'wash the dishes' is standard. In British English, 'wash up' means the same thing — but in American English, 'wash up' means wash your hands!"
        },
        {
          "text": "Kitchen Safety Collocations",
          "depth": 2,
          "name": "Kitchen Safety Collocations"
        },
        {
          "text": "Common safety phrases: 'turn off the stove', 'unplug the toaster', 'the pot is boiling over', 'watch out — the pan is hot', 'keep knives out of reach of children'.",
          "depth": 2,
          "name": "Common safety phrases: 'turn off the stove', 'unplug the toaster', 'the pot is boiling over', 'watch out — the pan is hot', 'keep knives out of reach of children'."
        }
      ]
    },
