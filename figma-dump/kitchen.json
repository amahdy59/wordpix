        {
          "text": "🗣️ Mini Dialogue",
          "depth": 1,
          "name": "🗣️ Mini Dialogue"
        },
        {
          "text": "Scene: A parent teaches their child to make breakfast in the kitchen",
          "depth": 1,
          "name": "Scene: A parent teaches their child to make breakfast in the kitchen"
        },
        {
          "text": "Parent:",
          "depth": 2,
          "name": "Parent:"
        },
        {
          "text": "Good morning! Let's make breakfast together. Take the eggs out of the refrigerator.",
          "depth": 2,
          "name": "Good morning! Let's make breakfast together. Take the eggs out of the refrigerator."
        },
        {
          "text": "Child:",
          "depth": 2,
          "name": "Child:"
        },
        {
          "text": "OK. Should I use the frying pan or the saucepan?",
          "depth": 2,
          "name": "OK. Should I use the frying pan or the saucepan?"
        },
        {
          "text": "Parent:",
          "depth": 2,
          "name": "Parent:"
        },
        {
          "text": "The frying pan for the eggs. Put it on the stove and turn the heat to medium.",
          "depth": 2,
          "name": "The frying pan for the eggs. Put it on the stove and turn the heat to medium."
        },
        {
          "text": "Child:",
          "depth": 2,
          "name": "Child:"
        },
        {
          "text": "Can I make toast too? Where's the toaster?",
          "depth": 2,
          "name": "Can I make toast too? Where's the toaster?"
        },
        {
          "text": "Parent:",
          "depth": 2,
          "name": "Parent:"
        },
        {
          "text": "Next to the coffee maker on the counter. Use the knife to spread the butter, and the spoon for the jam.",
          "depth": 2,
          "name": "Next to the coffee maker on the counter. Use the knife to spread the butter, and the spoon for the jam."
        },
        {
          "text": "Child:",
          "depth": 2,
          "name": "Child:"
        },
        {
          "text": "I want to try the blender for a smoothie. Can I?",
          "depth": 2,
          "name": "I want to try the blender for a smoothie. Can I?"
        },
        {
          "text": "Parent:",
          "depth": 2,
          "name": "Parent:"
        },
        {
          "text": "Sure — put the fruit in the blender, add milk, and press the button. Use a bowl if you want cereal instead.",
          "depth": 2,
          "name": "Sure — put the fruit in the blender, add milk, and press the button. Use a bowl if you want cereal instead."
        },
        {
          "text": "Child:",
          "depth": 2,
          "name": "Child:"
        },
        {
          "text": "The kettle is boiling. Should I make tea?",
          "depth": 2,
          "name": "The kettle is boiling. Should I make tea?"
        },
        {
          "text": "Parent:",
          "depth": 2,
          "name": "Parent:"
        },
        {
          "text": "Yes please. Cups are in the cabinet above the dishwasher. Use the spatula to flip the eggs — they're almost done.",
          "depth": 2,
          "name": "Yes please. Cups are in the cabinet above the dishwasher. Use the spatula to flip the eggs — they're almost done."
        },
        {
          "text": "Child:",
          "depth": 2,
          "name": "Child:"
        },
        {
          "text": "Where do I put the dirty dishes? The sink is full.",
          "depth": 2,
          "name": "Where do I put the dirty dishes? The sink is full."
        }
      ]
    },
    "common-mistakes": {
      "nodeId": "542:1465",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"I cooked a coffee this morning.\"",
          "depth": 2,
          "name": "❌ \"I cooked a coffee this morning.\""
        },
        {
          "text": "✅ \"I made a coffee this morning.\"",
          "depth": 2,
          "name": "✅ \"I made a coffee this morning.\""
        },
        {
          "text": "We 'make' drinks (coffee, tea, juice), not 'cook' them. 'Cook' is for food prepared with heat.",
          "depth": 2,
          "name": "We 'make' drinks (coffee, tea, juice), not 'cook' them. 'Cook' is for food prepared with heat."
        },
        {
          "text": "❌ \"Can you borrow me your blender?\"",
          "depth": 2,
          "name": "❌ \"Can you borrow me your blender?\""
        },
        {
          "text": "✅ \"Can you lend me your blender?\"",
          "depth": 2,
          "name": "✅ \"Can you lend me your blender?\""
        },
        {
          "text": "'Lend' = give temporarily. 'Borrow' = take temporarily. The giver lends; the taker borrows.",
          "depth": 2,
          "name": "'Lend' = give temporarily. 'Borrow' = take temporarily. The giver lends; the taker borrows."
        },
        {
          "text": "❌ \"Put the food in the oven and cook it until 20 minutes.\"",
          "depth": 2,
          "name": "❌ \"Put the food in the oven and cook it until 20 minutes.\""
        },
        {
          "text": "✅ \"Put the food in the oven and cook it for 20 minutes.\"",
          "depth": 2,
          "name": "✅ \"Put the food in the oven and cook it for 20 minutes.\""
        },
        {
          "text": "Use 'for' with a duration ('for 20 minutes'), not 'until'. 'Until' is for a specific time ('until 6 PM').",
          "depth": 2,
          "name": "Use 'for' with a duration ('for 20 minutes'), not 'until'. 'Until' is for a specific time ('until 6 PM')."
        },
        {
          "text": "❌ \"The knife is not enough sharp.\"",
          "depth": 2,
          "name": "❌ \"The knife is not enough sharp.\""
        },
        {
          "text": "✅ \"The knife is not sharp enough.\"",
          "depth": 2,
          "name": "✅ \"The knife is not sharp enough.\""
        },
        {
          "text": "'Enough' comes after the adjective: 'sharp enough', 'hot enough', 'big enough'.",
          "depth": 2,
          "name": "'Enough' comes after the adjective: 'sharp enough', 'hot enough', 'big enough'."
        },
        {
          "text": "❌ \"I cut myself by the knife.\"",
          "depth": 2,
          "name": "❌ \"I cut myself by the knife.\""
        },
        {
          "text": "✅ \"I cut myself with the knife.\"",
          "depth": 2,
          "name": "✅ \"I cut myself with the knife.\""
        },
        {
          "text": "Use 'with' for tools and instruments ('cut with a knife', 'eat with a fork').",
          "depth": 2,
          "name": "Use 'with' for tools and instruments ('cut with a knife', 'eat with a fork')."
        }
      ]
    },
