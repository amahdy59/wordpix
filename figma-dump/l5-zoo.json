    "cultural-notes": {
      "nodeId": "547:199",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "Zoo vs Safari Park",
          "depth": 2,
          "name": "Zoo vs Safari Park"
        },
        {
          "text": "A zoo keeps animals in enclosures visitors walk past. A safari park lets visitors drive through larger areas where animals roam more freely. In the UK, popular examples are London Zoo and Longleat Safari Park.",
          "depth": 2,
          "name": "A zoo keeps animals in enclosures visitors walk past. A safari park lets visitors drive through larger areas where animals roam more freely. In the UK, popular examples are London Zoo and Longleat Safari Park."
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "British: 'zoological gardens' (formal) / American: 'zoo' (both use 'zoo' informally). British: 'enclosure' / American: sometimes 'exhibit'. British: 'keeper' / American: 'zookeeper'.",
          "depth": 2,
          "name": "British: 'zoological gardens' (formal) / American: 'zoo' (both use 'zoo' informally). British: 'enclosure' / American: sometimes 'exhibit'. British: 'keeper' / American: 'zookeeper'."
        },
        {
          "text": "Conservation & Ethics",
          "depth": 2,
          "name": "Conservation & Ethics"
        },
        {
          "text": "Modern zoos focus on conservation, education, and research — not just entertainment. Many run breeding programmes for endangered species and fund wildlife protection in the wild. This is a common discussion topic in English classes.",
          "depth": 2,
          "name": "Modern zoos focus on conservation, education, and research — not just entertainment. Many run breeding programmes for endangered species and fund wildlife protection in the wild. This is a common discussion topic in English classes."
        },
        {
          "text": "Animal Collective Nouns",
          "depth": 2,
          "name": "Animal Collective Nouns"
        },
        {
          "text": "English has special group names for animals: a pride of lions, a herd of elephants, a flock of birds, a pack of wolves, a troop of monkeys. These are tested in B1–B2 exams.",
          "depth": 2,
          "name": "English has special group names for animals: a pride of lions, a herd of elephants, a flock of birds, a pack of wolves, a troop of monkeys. These are tested in B1–B2 exams."
        },
        {
          "text": "Petting Zoos",
          "depth": 2,
          "name": "Petting Zoos"
        },
        {
          "text": "A 'petting zoo' is a section where children can touch and feed gentle animals like goats, rabbits, and guinea pigs. It's also called a 'children's farm' in some countries.",
          "depth": 2,
          "name": "A 'petting zoo' is a section where children can touch and feed gentle animals like goats, rabbits, and guinea pigs. It's also called a 'children's farm' in some countries."
        }
      ]
    },
