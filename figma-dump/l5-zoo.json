          "depth": 2,
          "name": "reveal a secret accidentally"
        },
        {
          "text": "\"She let the cat out of the bag about the surprise party.\"",
          "depth": 2,
          "name": "\"She let the cat out of the bag about the surprise party.\""
        },
        {
          "text": "the elephant in the room",
