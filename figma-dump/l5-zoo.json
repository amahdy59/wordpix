        },
        {
          "text": "someone who feels uncomfortable in a situation",
          "depth": 2,
          "name": "someone who feels uncomfortable in a situation"
        },
        {
          "text": "\"I felt like a fish out of water at the formal dinner.\"",
          "depth": 2,
          "name": "\"I felt like a fish out of water at the formal dinner.\""
        },
        {
          "text": "watch out for",
          "depth": 2,
          "name": "watch out for"
        },
        {
          "text": "be careful about something",
          "depth": 2,
          "name": "be careful about something"
        },
        {
          "text": "\"Watch out for the wet floor near the penguin enclosure.\"",
          "depth": 2,
          "name": "\"Watch out for the wet floor near the penguin enclosure.\""
        },
        {
          "text": "look after",
          "depth": 2,
          "name": "look after"
        },
        {
          "text": "take care of",
          "depth": 2,
          "name": "take care of"
        },
        {
          "text": "\"Zookeepers look after the animals every day.\"",
          "depth": 2,
          "name": "\"Zookeepers look after the animals every day.\""
        },
        {
          "text": "die out",
          "depth": 2,
          "name": "die out"
        },
        {
          "text": "become extinct",
          "depth": 2,
          "name": "become extinct"
        },
        {
          "text": "\"Many species will die out if we don't protect their habitats.\"",
          "depth": 2,
          "name": "\"Many species will die out if we don't protect their habitats.\""
        },
        {
          "text": "break free",
          "depth": 2,
