        {
          "text": "Father:",
          "depth": 2,
          "name": "Father:"
        },
        {
          "text": "Yes, lions sleep up to twenty hours a day. They're most active at dawn and dusk.",
          "depth": 2,
          "name": "Yes, lions sleep up to twenty hours a day. They're most active at dawn and dusk."
        },
        {
          "text": "Son:",
          "depth": 2,
          "name": "Son:"
        },
        {
          "text": "Wow, that's a lot! Can we feed them?",
          "depth": 2,
          "name": "Wow, that's a lot! Can we feed them?"
        },
        {
          "text": "Father:",
          "depth": 2,
          "name": "Father:"
        },
        {
          "text": "No, only the zookeepers are allowed to feed the animals. It's for everyone's safety.",
