    "common-mistakes": {
      "nodeId": "547:97",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"I saw a monkey who was eating a banana.\"",
          "depth": 2,
          "name": "❌ \"I saw a monkey who was eating a banana.\""
        },
        {
          "text": "✅ \"I saw a monkey that was eating a banana.\"",
          "depth": 2,
          "name": "✅ \"I saw a monkey that was eating a banana.\""
        },
        {
          "text": "Use 'that' or 'which' for animals (unless you know the animal personally, e.g. a pet). 'Who' is for people.",
          "depth": 2,
          "name": "Use 'that' or 'which' for animals (unless you know the animal personally, e.g. a pet). 'Who' is for people."
        },
        {
          "text": "❌ \"There are many differents animals at the zoo.\"",
          "depth": 2,
          "name": "❌ \"There are many differents animals at the zoo.\""
        },
        {
          "text": "✅ \"There are many different animals at the zoo.\"",
          "depth": 2,
          "name": "✅ \"There are many different animals at the zoo.\""
        },
        {
          "text": "Adjectives in English never take a plural 's'. 'Different' stays the same whether describing one or many things.",
          "depth": 2,
          "name": "Adjectives in English never take a plural 's'. 'Different' stays the same whether describing one or many things."
        },
        {
          "text": "❌ \"We went to see the animals in the cage.\"",
          "depth": 2,
          "name": "❌ \"We went to see the animals in the cage.\""
        },
        {
          "text": "✅ \"We went to see the animals in the enclosure.\"",
          "depth": 2,
          "name": "✅ \"We went to see the animals in the enclosure.\""
        },
        {
          "text": "Modern zoos use 'enclosures' — open or semi-open spaces. 'Cage' implies small, barred spaces and sounds outdated for professional zoos.",
          "depth": 2,
          "name": "Modern zoos use 'enclosures' — open or semi-open spaces. 'Cage' implies small, barred spaces and sounds outdated for professional zoos."
        },
        {
          "text": "❌ \"The zookeeper feeded the penguins.\"",
          "depth": 2,
          "name": "❌ \"The zookeeper feeded the penguins.\""
        },
        {
          "text": "✅ \"The zookeeper fed the penguins.\"",
          "depth": 2,
          "name": "✅ \"The zookeeper fed the penguins.\""
        },
        {
          "text": "'Feed' is irregular: feed–fed–fed. There is no 'feeded'.",
          "depth": 2,
          "name": "'Feed' is irregular: feed–fed–fed. There is no 'feeded'."
        },
        {
          "text": "❌ \"An elephant is a biggest land animal.\"",
          "depth": 2,
          "name": "❌ \"An elephant is a biggest land animal.\""
        },
        {
          "text": "✅ \"The elephant is the biggest land animal.\"",
          "depth": 2,
          "name": "✅ \"The elephant is the biggest land animal.\""
        },
        {
          "text": "Use 'the' (not 'a/an') with superlatives and when talking about a species in general.",
          "depth": 2,
          "name": "Use 'the' (not 'a/an') with superlatives and when talking about a species in general."
        }
      ]
    },
