    "common-mistakes": {
      "nodeId": "544:373",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"I want a bread, please.\"",
          "depth": 2,
          "name": "❌ \"I want a bread, please.\""
        },
        {
          "text": "✅ \"I want a loaf of bread, please.\" / \"I want some bread.\"",
          "depth": 2,
          "name": "✅ \"I want a loaf of bread, please.\" / \"I want some bread.\""
        },
        {
          "text": "'Bread' is uncountable. Use 'a loaf of', 'a slice of', 'a piece of', or 'some bread'.",
          "depth": 2,
          "name": "'Bread' is uncountable. Use 'a loaf of', 'a slice of', 'a piece of', or 'some bread'."
        },
        {
          "text": "❌ \"The cake is very delicious.\"",
          "depth": 2,
          "name": "❌ \"The cake is very delicious.\""
        },
        {
          "text": "✅ \"The cake is delicious.\"",
          "depth": 2,
          "name": "✅ \"The cake is delicious.\""
        },
        {
          "text": "'Delicious' is already strong — don't add 'very'. Use 'absolutely delicious' for emphasis.",
          "depth": 2,
          "name": "'Delicious' is already strong — don't add 'very'. Use 'absolutely delicious' for emphasis."
        },
        {
          "text": "❌ \"She baked a cake since three hours.\"",
          "depth": 2,
          "name": "❌ \"She baked a cake since three hours.\""
        },
        {
          "text": "✅ \"She has been baking a cake for three hours.\"",
          "depth": 2,
          "name": "✅ \"She has been baking a cake for three hours.\""
        },
        {
          "text": "Use 'for' + duration, not 'since'. 'Since' needs a point in time ('since 2 PM').",
          "depth": 2,
          "name": "Use 'for' + duration, not 'since'. 'Since' needs a point in time ('since 2 PM')."
        },
        {
          "text": "❌ \"I like breads with butter.\"",
          "depth": 2,
          "name": "❌ \"I like breads with butter.\""
        },
        {
          "text": "✅ \"I like bread with butter.\"",
          "depth": 2,
          "name": "✅ \"I like bread with butter.\""
        },
        {
          "text": "'Bread' doesn't have a plural form in general use. 'Breads' only refers to different types of bread.",
          "depth": 2,
          "name": "'Bread' doesn't have a plural form in general use. 'Breads' only refers to different types of bread."
        },
        {
          "text": "❌ \"The dough is enough soft now.\"",
          "depth": 2,
          "name": "❌ \"The dough is enough soft now.\""
        },
        {
          "text": "✅ \"The dough is soft enough now.\"",
          "depth": 2,
          "name": "✅ \"The dough is soft enough now.\""
        },
        {
          "text": "'Enough' follows the adjective: 'soft enough', 'warm enough'. Not 'enough soft'.",
          "depth": 2,
          "name": "'Enough' follows the adjective: 'soft enough', 'warm enough'. Not 'enough soft'."
        }
      ]
    },
