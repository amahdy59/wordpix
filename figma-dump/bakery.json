    "cultural-notes": {
      "nodeId": "544:475",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "Bakery vs Baker's",
          "depth": 2,
          "name": "Bakery vs Baker's"
        },
        {
          "text": "In British English, 'the baker's' (with possessive) is common: 'I'm going to the baker's.' In American English, 'bakery' is standard. Both are correct.",
          "depth": 2,
          "name": "In British English, 'the baker's' (with possessive) is common: 'I'm going to the baker's.' In American English, 'bakery' is standard. Both are correct."
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "British: 'biscuit' / American: 'cookie'. British: 'scone' (rhymes with 'gone') / American: 'scone' (rhymes with 'bone'). British: 'icing' / American: 'frosting'.",
          "depth": 2,
          "name": "British: 'biscuit' / American: 'cookie'. British: 'scone' (rhymes with 'gone') / American: 'scone' (rhymes with 'bone'). British: 'icing' / American: 'frosting'."
        },
        {
          "text": "Bread Culture",
          "depth": 2,
          "name": "Bread Culture"
        },
        {
          "text": "The UK has a strong bread culture: white, wholemeal, granary, tiger bread, and sourdough are all common. Toast with butter is a breakfast staple. 'A sandwich' literally means food between two slices of bread.",
          "depth": 2,
          "name": "The UK has a strong bread culture: white, wholemeal, granary, tiger bread, and sourdough are all common. Toast with butter is a breakfast staple. 'A sandwich' literally means food between two slices of bread."
        },
        {
          "text": "Afternoon Tea",
          "depth": 2,
          "name": "Afternoon Tea"
        },
        {
          "text": "'Afternoon tea' is a British tradition: small sandwiches, scones with clotted cream and jam, and cakes served with tea. 'Cream tea' is just scones, cream, and jam. The order — cream first or jam first — is a famous debate!",
          "depth": 2,
          "name": "'Afternoon tea' is a British tradition: small sandwiches, scones with clotted cream and jam, and cakes served with tea. 'Cream tea' is just scones, cream, and jam. The order — cream first or jam first — is a famous debate!"
        },
        {
          "text": "Artisan and Sourdough Trend",
          "depth": 2,
          "name": "Artisan and Sourdough Trend"
        },
        {
          "text": "'Artisan bread' (hand-crafted, small-batch) and 'sourdough' (naturally fermented) have become trendy in English-speaking countries. These words appear frequently on menus and in food media.",
          "depth": 2,
          "name": "'Artisan bread' (hand-crafted, small-batch) and 'sourdough' (naturally fermented) have become trendy in English-speaking countries. These words appear frequently on menus and in food media."
        }
      ]
    },
