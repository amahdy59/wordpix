    "cultural-notes": {
      "nodeId": "542:1843",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "British: \"sitting room\" or \"lounge\" / American: \"living room\" or \"family room\". British: \"settee\" / American: \"couch\" or \"sofa\" (sofa is used in both). British: \"telly\" / American: \"TV\".",
          "depth": 2,
          "name": "British: \"sitting room\" or \"lounge\" / American: \"living room\" or \"family room\". British: \"settee\" / American: \"couch\" or \"sofa\" (sofa is used in both). British: \"telly\" / American: \"TV\"."
        },
        {
          "text": "Living Room vs Lounge vs Den",
          "depth": 2,
          "name": "Living Room vs Lounge vs Den"
        },
        {
          "text": "'Living room' is the most common term. 'Lounge' is British and slightly formal. 'Den' (American) is a smaller, cosier room for relaxing. 'Family room' emphasises casual family use.",
          "depth": 2,
          "name": "'Living room' is the most common term. 'Lounge' is British and slightly formal. 'Den' (American) is a smaller, cosier room for relaxing. 'Family room' emphasises casual family use."
        },
        {
          "text": "Furniture as Uncountable",
          "depth": 2,
          "name": "Furniture as Uncountable"
        },
        {
          "text": "'Furniture' is uncountable in English. Say 'a piece of furniture' or 'some furniture' — never 'a furniture' or 'furnitures'. Same rule applies to 'equipment' and 'luggage'.",
          "depth": 2,
          "name": "'Furniture' is uncountable in English. Say 'a piece of furniture' or 'some furniture' — never 'a furniture' or 'furnitures'. Same rule applies to 'equipment' and 'luggage'."
        },
        {
          "text": "Shoes On or Off?",
          "depth": 2,
          "name": "Shoes On or Off?"
        },
        {
          "text": "In many English-speaking homes, guests may keep shoes on unless told otherwise. In contrast, many cultures expect shoes off. A doormat at the entrance is a common feature — some homes provide slippers.",
          "depth": 2,
          "name": "In many English-speaking homes, guests may keep shoes on unless told otherwise. In contrast, many cultures expect shoes off. A doormat at the entrance is a common feature — some homes provide slippers."
        },
        {
          "text": "Small Talk About Homes",
          "depth": 2,
          "name": "Small Talk About Homes"
        },
        {
          "text": "Complimenting someone's living room is good small talk: 'What a lovely room!', 'I love your sofa!', 'This is such a cosy space.' It's polite and shows interest in the host's home.",
          "depth": 2,
          "name": "Complimenting someone's living room is good small talk: 'What a lovely room!', 'I love your sofa!', 'This is such a cosy space.' It's polite and shows interest in the host's home."
        }
      ]
    },
