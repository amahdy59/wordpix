    "mini-dialogue": {
      "nodeId": "542:1706",
      "lines": [
        {
          "text": "🗣️ Mini Dialogue",
          "depth": 1,
          "name": "🗣️ Mini Dialogue"
        },
        {
          "text": "Scene: A couple rearranging their living room",
          "depth": 1,
          "name": "Scene: A couple rearranging their living room"
        },
        {
          "text": "Sara:",
          "depth": 2,
          "name": "Sara:"
        },
        {
          "text": "I think we should move the sofa closer to the window. What do you think?",
          "depth": 2,
          "name": "I think we should move the sofa closer to the window. What do you think?"
        },
        {
          "text": "Omar:",
          "depth": 2,
          "name": "Omar:"
        },
        {
          "text": "Maybe. But then where do we put the floor lamp?",
          "depth": 2,
          "name": "Maybe. But then where do we put the floor lamp?"
        },
        {
          "text": "Sara:",
          "depth": 2,
          "name": "Sara:"
        },
        {
          "text": "We could put it in the corner, next to the bookshelf. It would look nice there.",
          "depth": 2,
          "name": "We could put it in the corner, next to the bookshelf. It would look nice there."
        },
        {
          "text": "Omar:",
          "depth": 2,
          "name": "Omar:"
        },
        {
          "text": "Okay. And the coffee table — should we keep it in the centre?",
          "depth": 2,
          "name": "Okay. And the coffee table — should we keep it in the centre?"
        },
        {
          "text": "Sara:",
          "depth": 2,
          "name": "Sara:"
        },
        {
          "text": "Yes, but let's add a rug underneath. The floor feels cold in winter.",
          "depth": 2,
          "name": "Yes, but let's add a rug underneath. The floor feels cold in winter."
        },
        {
          "text": "Omar:",
          "depth": 2,
          "name": "Omar:"
        },
        {
          "text": "Good idea. I also want to hang some picture frames on that empty wall.",
          "depth": 2,
          "name": "Good idea. I also want to hang some picture frames on that empty wall."
        },
        {
          "text": "Sara:",
          "depth": 2,
          "name": "Sara:"
        },
        {
          "text": "I was thinking the same thing! And maybe a wall clock above the TV stand.",
          "depth": 2,
          "name": "I was thinking the same thing! And maybe a wall clock above the TV stand."
        },
        {
          "text": "Omar:",
          "depth": 2,
          "name": "Omar:"
        },
        {
          "text": "What about the cushions? These ones are getting old.",
          "depth": 2,
          "name": "What about the cushions? These ones are getting old."
        },
        {
          "text": "Sara:",
          "depth": 2,
          "name": "Sara:"
        },
        {
          "text": "Let's get new cushions and a throw blanket for the armchair. Something warm.",
          "depth": 2,
          "name": "Let's get new cushions and a throw blanket for the armchair. Something warm."
        },
        {
          "text": "Omar:",
          "depth": 2,
          "name": "Omar:"
        },
        {
          "text": "Sounds great. A few small changes can really make the living room feel brand new.",
          "depth": 2,
          "name": "Sounds great. A few small changes can really make the living room feel brand new."
        }
      ]
    },
    "common-mistakes": {
      "nodeId": "542:1741",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"I sat in the sofa.\"",
          "depth": 2,
          "name": "❌ \"I sat in the sofa.\""
        },
        {
          "text": "✅ \"I sat on the sofa.\"",
          "depth": 2,
          "name": "✅ \"I sat on the sofa.\""
        },
        {
          "text": "You sit 'on' a sofa, chair, or bench (flat surface). You sit 'in' an armchair (enclosed sides) or 'in' a car.",
          "depth": 2,
          "name": "You sit 'on' a sofa, chair, or bench (flat surface). You sit 'in' an armchair (enclosed sides) or 'in' a car."
        },
        {
          "text": "❌ \"We watched the television whole day.\"",
          "depth": 2,
          "name": "❌ \"We watched the television whole day.\""
        },
        {
          "text": "✅ \"We watched television all day.\" / \"We watched TV the whole day.\"",
          "depth": 2,
          "name": "✅ \"We watched television all day.\" / \"We watched TV the whole day.\""
        },
        {
          "text": "'All day' or 'the whole day' — not 'whole day' alone. Also, 'watch television' (no 'the') when speaking generally.",
          "depth": 2,
          "name": "'All day' or 'the whole day' — not 'whole day' alone. Also, 'watch television' (no 'the') when speaking generally."
        },
        {
          "text": "❌ \"She put cushions in the sofa.\"",
          "depth": 2,
          "name": "❌ \"She put cushions in the sofa.\""
        },
        {
          "text": "✅ \"She put cushions on the sofa.\"",
          "depth": 2,
          "name": "✅ \"She put cushions on the sofa.\""
        },
        {
          "text": "Cushions go 'on' the sofa (on the surface). 'In' suggests inside the sofa itself.",
          "depth": 2,
          "name": "Cushions go 'on' the sofa (on the surface). 'In' suggests inside the sofa itself."
        },
        {
          "text": "❌ \"Please close the light.\"",
          "depth": 2,
          "name": "❌ \"Please close the light.\""
        },
        {
          "text": "✅ \"Please turn off the light.\"",
          "depth": 2,
          "name": "✅ \"Please turn off the light.\""
        },
        {
          "text": "In English we 'turn on' and 'turn off' lights and electronics. 'Close' is for doors, windows, and lids.",
          "depth": 2,
          "name": "In English we 'turn on' and 'turn off' lights and electronics. 'Close' is for doors, windows, and lids."
        },
        {
          "text": "❌ \"I enjoy to watch movies at home.\"",
          "depth": 2,
          "name": "❌ \"I enjoy to watch movies at home.\""
        },
        {
          "text": "✅ \"I enjoy watching movies at home.\"",
          "depth": 2,
          "name": "✅ \"I enjoy watching movies at home.\""
        },
        {
          "text": "'Enjoy' is followed by a gerund (-ing form), not an infinitive. Same for: avoid, finish, keep, suggest.",
          "depth": 2,
          "name": "'Enjoy' is followed by a gerund (-ing form), not an infinitive. Same for: avoid, finish, keep, suggest."
        }
      ]
    },
