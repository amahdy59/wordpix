    "mini-dialogue": {
      "nodeId": "542:3094",
      "lines": [
        {
          "text": "🗣️ Mini Dialogue",
          "depth": 1,
          "name": "🗣️ Mini Dialogue"
        },
        {
          "text": "Scene: A teacher prepares the classroom for a new school year with a student helper",
          "depth": 1,
          "name": "Scene: A teacher prepares the classroom for a new school year with a student helper"
        },
        {
          "text": "Teacher:",
          "depth": 2,
          "name": "Teacher:"
        },
        {
          "text": "Thank you for helping me set up. Can you put a pencil, a pen, and an eraser on each desk?",
          "depth": 2,
          "name": "Thank you for helping me set up. Can you put a pencil, a pen, and an eraser on each desk?"
        },
        {
          "text": "Student:",
          "depth": 2,
          "name": "Student:"
        },
        {
          "text": "Sure. Should I add a ruler and a marker too? There are extras in the pencil case on the shelf.",
          "depth": 2,
          "name": "Sure. Should I add a ruler and a marker too? There are extras in the pencil case on the shelf."
        },
        {
          "text": "Teacher:",
          "depth": 2,
          "name": "Teacher:"
        },
        {
          "text": "Yes, please. And put one notebook, one textbook, and one workbook in every chair pocket.",
          "depth": 2,
          "name": "Yes, please. And put one notebook, one textbook, and one workbook in every chair pocket."
        },
        {
          "text": "Student:",
          "depth": 2,
          "name": "Student:"
        },
        {
          "text": "What about the folder and the binder? They're heavy.",
          "depth": 2,
          "name": "What about the folder and the binder? They're heavy."
        },
        {
          "text": "Teacher:",
          "depth": 2,
          "name": "Teacher:"
        },
        {
          "text": "Leave those on the shelf for now. Stack the sheets of paper and the sticky notes near the projector.",
          "depth": 2,
          "name": "Leave those on the shelf for now. Stack the sheets of paper and the sticky notes near the projector."
        },
        {
          "text": "Student:",
          "depth": 2,
          "name": "Student:"
        },
        {
          "text": "I found some colored pencils, crayons, and a pencil sharpener in the locker. Where do they go?",
          "depth": 2,
          "name": "I found some colored pencils, crayons, and a pencil sharpener in the locker. Where do they go?"
        },
        {
          "text": "Teacher:",
          "depth": 2,
          "name": "Teacher:"
        },
        {
          "text": "Put the colored pencils and crayons in the art box near the whiteboard. The highlighter goes in the desk drawer.",
          "depth": 2,
          "name": "Put the colored pencils and crayons in the art box near the whiteboard. The highlighter goes in the desk drawer."
        },
        {
          "text": "Student:",
          "depth": 2,
          "name": "Student:"
        },
        {
          "text": "The globe is dusty. Should I clean it? And the clock on the wall — it's stopped.",
          "depth": 2,
          "name": "The globe is dusty. Should I clean it? And the clock on the wall — it's stopped."
        },
        {
          "text": "Teacher:",
          "depth": 2,
          "name": "Teacher:"
        },
        {
          "text": "Clean the globe, yes. I'll fix the clock later. Can you pin the class schedule on the bulletin board?",
          "depth": 2,
          "name": "Clean the globe, yes. I'll fix the clock later. Can you pin the class schedule on the bulletin board?"
        },
        {
          "text": "Student:",
          "depth": 2,
          "name": "Student:"
        },
        {
          "text": "Done! I also found scissors, a glue stick, and some tape in the backpack someone left behind.",
          "depth": 2,
          "name": "Done! I also found scissors, a glue stick, and some tape in the backpack someone left behind."
        }
      ]
    },
    "common-mistakes": {
      "nodeId": "542:3129",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"The teacher explained us the lesson.\"",
          "depth": 2,
          "name": "❌ \"The teacher explained us the lesson.\""
        },
        {
          "text": "✅ \"The teacher explained the lesson to us.\"",
          "depth": 2,
          "name": "✅ \"The teacher explained the lesson to us.\""
        },
        {
          "text": "'Explain' needs 'to' before the person: 'explain something to someone', not 'explain someone something'.",
          "depth": 2,
          "name": "'Explain' needs 'to' before the person: 'explain something to someone', not 'explain someone something'."
        },
        {
          "text": "❌ \"I forgot my book at home.\"",
          "depth": 2,
          "name": "❌ \"I forgot my book at home.\""
        },
        {
          "text": "✅ \"I left my book at home.\"",
          "depth": 2,
          "name": "✅ \"I left my book at home.\""
        },
        {
          "text": "'Forget' = fail to remember. 'Leave' = fail to bring from a place. Use 'left' when mentioning the location.",
          "depth": 2,
          "name": "'Forget' = fail to remember. 'Leave' = fail to bring from a place. Use 'left' when mentioning the location."
        },
        {
          "text": "❌ \"Can I lend your pen?\"",
          "depth": 2,
          "name": "❌ \"Can I lend your pen?\""
        },
        {
          "text": "✅ \"Can I borrow your pen?\"",
          "depth": 2,
          "name": "✅ \"Can I borrow your pen?\""
        },
        {
          "text": "'Borrow' = take temporarily. 'Lend' = give temporarily. You borrow FROM someone; they lend TO you.",
          "depth": 2,
          "name": "'Borrow' = take temporarily. 'Lend' = give temporarily. You borrow FROM someone; they lend TO you."
        },
        {
          "text": "❌ \"She is good in English.\"",
          "depth": 2,
          "name": "❌ \"She is good in English.\""
        },
        {
          "text": "✅ \"She is good at English.\"",
          "depth": 2,
          "name": "✅ \"She is good at English.\""
        },
        {
          "text": "In English, we say 'good at' a subject or skill, not 'good in'.",
          "depth": 2,
          "name": "In English, we say 'good at' a subject or skill, not 'good in'."
        },
        {
          "text": "❌ \"I made many mistakes in the exam.\" (nothing wrong!) — but: \"I did a mistake.\"",
          "depth": 2,
          "name": "❌ \"I made many mistakes in the exam.\" (nothing wrong!) — but: \"I did a mistake.\""
        },
        {
          "text": "✅ \"I made a mistake.\"",
          "depth": 2,
          "name": "✅ \"I made a mistake.\""
        },
        {
          "text": "The correct collocation is 'make a mistake', not 'do a mistake'. But 'do an exam/exercise' is correct.",
          "depth": 2,
          "name": "The correct collocation is 'make a mistake', not 'do a mistake'. But 'do an exam/exercise' is correct."
        }
      ]
    },
