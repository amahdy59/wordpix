    "cultural-notes": {
      "nodeId": "542:3231",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Vocabulary",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Vocabulary"
        },
        {
          "text": "British: 'rubber' / American: 'eraser'. British: 'maths' / American: 'math'. British: 'timetable' / American: 'schedule'. British: 'revise' / American: 'review/study'.",
          "depth": 2,
          "name": "British: 'rubber' / American: 'eraser'. British: 'maths' / American: 'math'. British: 'timetable' / American: 'schedule'. British: 'revise' / American: 'review/study'."
        },
        {
          "text": "Classroom Etiquette",
          "depth": 2,
          "name": "Classroom Etiquette"
        },
        {
          "text": "In English-speaking classrooms, raising your hand before speaking is expected. Saying 'Excuse me' or 'Sorry to interrupt' is polite when asking a question during a lesson.",
          "depth": 2,
          "name": "In English-speaking classrooms, raising your hand before speaking is expected. Saying 'Excuse me' or 'Sorry to interrupt' is polite when asking a question during a lesson."
        },
        {
          "text": "Stationery vs Stationary",
          "depth": 2,
          "name": "Stationery vs Stationary"
        },
        {
          "text": "'Stationery' (with an 'e') = pens, paper, envelopes — writing supplies. 'Stationary' (with an 'a') = not moving. A common spelling trap for learners!",
          "depth": 2,
          "name": "'Stationery' (with an 'e') = pens, paper, envelopes — writing supplies. 'Stationary' (with an 'a') = not moving. A common spelling trap for learners!"
        },
        {
          "text": "Homework, Coursework, Assignment",
          "depth": 2,
          "name": "Homework, Coursework, Assignment"
        },
        {
          "text": "'Homework' = work done at home. 'Coursework' = ongoing assessed work during a course. 'Assignment' = a specific task given by the teacher. All three are uncountable or used with 'an/a piece of'.",
          "depth": 2,
          "name": "'Homework' = work done at home. 'Coursework' = ongoing assessed work during a course. 'Assignment' = a specific task given by the teacher. All three are uncountable or used with 'an/a piece of'."
        },
        {
          "text": "School Supplies Shopping",
          "depth": 2,
          "name": "School Supplies Shopping"
        },
        {
          "text": "In the UK and US, 'back-to-school shopping' in August/September is a cultural event. Families buy notebooks, pens, folders, and backpacks — often during sales.",
          "depth": 2,
          "name": "In the UK and US, 'back-to-school shopping' in August/September is a cultural event. Families buy notebooks, pens, folders, and backpacks — often during sales."
        }
      ]
    },
