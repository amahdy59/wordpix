    "cultural-notes": {
      "nodeId": "542:3783",
      "lines": [
        {
          "text": "🌍 Cultural & Usage Notes",
          "depth": 1,
          "name": "🌍 Cultural & Usage Notes"
        },
        {
          "text": "Market vs Supermarket",
          "depth": 2,
          "name": "Market vs Supermarket"
        },
        {
          "text": "In English-speaking countries, 'market' usually means an outdoor or covered market with individual stalls. A 'supermarket' is a large self-service shop. 'Farmers' market' sells directly from producers.",
          "depth": 2,
          "name": "In English-speaking countries, 'market' usually means an outdoor or covered market with individual stalls. A 'supermarket' is a large self-service shop. 'Farmers' market' sells directly from producers."
        },
        {
          "text": "🇬🇧 vs 🇺🇸 Terms",
          "depth": 2,
          "name": "🇬🇧 vs 🇺🇸 Terms"
        },
        {
          "text": "British: 'stall' / American: 'stand' or 'booth'. British: 'queue' / American: 'line'. British: 'till' / American: 'register' or 'checkout'. British: 'shop' / American: 'store'.",
          "depth": 2,
          "name": "British: 'stall' / American: 'stand' or 'booth'. British: 'queue' / American: 'line'. British: 'till' / American: 'register' or 'checkout'. British: 'shop' / American: 'store'."
        },
        {
          "text": "Haggling Culture",
          "depth": 2,
          "name": "Haggling Culture"
        },
        {
          "text": "Haggling (negotiating the price) is common at markets in many countries but rare in UK/US shops and supermarkets. At car boot sales or flea markets, gentle bargaining is acceptable.",
          "depth": 2,
          "name": "Haggling (negotiating the price) is common at markets in many countries but rare in UK/US shops and supermarkets. At car boot sales or flea markets, gentle bargaining is acceptable."
        },
        {
          "text": "Units of Measurement",
          "depth": 2,
          "name": "Units of Measurement"
        },
        {
          "text": "UK markets use both kilograms and pounds (weight). US markets use pounds and ounces. Understanding 'a pound of apples' (≈450g) vs 'a kilo of apples' is useful.",
          "depth": 2,
          "name": "UK markets use both kilograms and pounds (weight). US markets use pounds and ounces. Understanding 'a pound of apples' (≈450g) vs 'a kilo of apples' is useful."
        },
        {
          "text": "Organic and Free-Range Labels",
          "depth": 2,
          "name": "Organic and Free-Range Labels"
        },
        {
          "text": "'Organic' = grown without synthetic chemicals. 'Free-range' = animals allowed to roam outdoors. 'Fair trade' = producers in developing countries receive a fair price. These labels are common at English markets.",
          "depth": 2,
          "name": "'Organic' = grown without synthetic chemicals. 'Free-range' = animals allowed to roam outdoors. 'Fair trade' = producers in developing countries receive a fair price. These labels are common at English markets."
