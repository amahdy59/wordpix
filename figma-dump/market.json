    "common-mistakes": {
      "nodeId": "542:3681",
      "lines": [
        {
          "text": "⚠️ Common Mistakes",
          "depth": 1,
          "name": "⚠️ Common Mistakes"
        },
        {
          "text": "❌ \"How much costs this?\"",
          "depth": 2,
          "name": "❌ \"How much costs this?\""
        },
        {
          "text": "✅ \"How much does this cost?\" / \"How much is this?\"",
          "depth": 2,
          "name": "✅ \"How much does this cost?\" / \"How much is this?\""
        },
        {
          "text": "In questions, use 'does' as the auxiliary: 'How much does it cost?' Not 'How much costs it?'",
          "depth": 2,
          "name": "In questions, use 'does' as the auxiliary: 'How much does it cost?' Not 'How much costs it?'"
        },
        {
          "text": "❌ \"I want to buy a bread.\"",
          "depth": 2,
          "name": "❌ \"I want to buy a bread.\""
        },
        {
          "text": "✅ \"I want to buy some bread.\" / \"I want to buy a loaf of bread.\"",
          "depth": 2,
          "name": "✅ \"I want to buy some bread.\" / \"I want to buy a loaf of bread.\""
        },
        {
          "text": "'Bread' is uncountable. Use 'some bread' or 'a loaf/piece/slice of bread'.",
          "depth": 2,
          "name": "'Bread' is uncountable. Use 'some bread' or 'a loaf/piece/slice of bread'."
        },
        {
          "text": "❌ \"The fruits are very fresh today.\"",
          "depth": 2,
          "name": "❌ \"The fruits are very fresh today.\""
        },
        {
          "text": "✅ \"The fruit is very fresh today.\"",
          "depth": 2,
          "name": "✅ \"The fruit is very fresh today.\""
        },
        {
          "text": "'Fruit' is usually uncountable when talking about fruit in general. 'Fruits' is used only when referring to different types.",
          "depth": 2,
          "name": "'Fruit' is usually uncountable when talking about fruit in general. 'Fruits' is used only when referring to different types."
        },
        {
          "text": "❌ \"She buyed vegetables at the market.\"",
          "depth": 2,
          "name": "❌ \"She buyed vegetables at the market.\""
        },
        {
          "text": "✅ \"She bought vegetables at the market.\"",
          "depth": 2,
          "name": "✅ \"She bought vegetables at the market.\""
        },
        {
          "text": "'Buy' is irregular: buy–bought–bought. There is no 'buyed'.",
          "depth": 2,
          "name": "'Buy' is irregular: buy–bought–bought. There is no 'buyed'."
        },
        {
          "text": "❌ \"I paid the tomatoes two pounds.\"",
          "depth": 2,
          "name": "❌ \"I paid the tomatoes two pounds.\""
        },
        {
          "text": "✅ \"I paid two pounds for the tomatoes.\"",
          "depth": 2,
          "name": "✅ \"I paid two pounds for the tomatoes.\""
        },
        {
          "text": "Use 'pay + amount + for + item'. Never 'pay + item + amount'.",
          "depth": 2,
          "name": "Use 'pay + amount + for + item'. Never 'pay + item + amount'."
        }
      ]
    },
